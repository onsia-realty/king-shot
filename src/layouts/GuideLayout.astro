---
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import RelatedGuides from '@/components/RelatedGuides.astro';
import {
  CATEGORY_EMOJI,
  DIFFICULTY_STYLES,
  categoryHref,
  formatDate,
  guideHref,
  isoDate,
  readingMinutes,
  type Guide,
} from '@/lib/guides';
import { SITE_NAME } from '@/data/nav';

interface Props {
  entry: Guide;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, category, tags, published, updated, difficulty } = entry.data;

const site = Astro.site ?? new URL('https://example.com');
const minutes = readingMinutes(entry.body);

const crumbs = [
  { label: '홈', href: '/' },
  { label: '공략', href: '/guides/' },
  { label: category, href: categoryHref(category) },
  { label: title },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  inLanguage: 'ko-KR',
  articleSection: category,
  keywords: tags.join(', '),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(guideHref(entry), site).href,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: site.href,
  },
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumb items={crumbs} class="mb-6" />

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-10">
      <article class="min-w-0">
        <header class="mb-8">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <a
              href={categoryHref(category)}
              class="inline-flex items-center gap-1 rounded-md border border-accent/40 bg-accent/12 px-2 py-0.5 text-xs font-bold text-accent no-underline hover:bg-accent/20 hover:text-accent"
            >
              <span aria-hidden="true">{CATEGORY_EMOJI[category]}</span>{category}
            </a>
            <span
              class:list={[
                'inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-bold',
                DIFFICULTY_STYLES[difficulty],
              ]}
            >
              난이도 {difficulty}
            </span>
          </div>

          <h1 class="text-3xl font-extrabold sm:text-4xl">{title}</h1>
          <p class="mt-3 text-base text-muted">{description}</p>

          <dl
            class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border pt-4 text-sm text-muted"
          >
            <div class="flex gap-1.5">
              <dt>발행</dt>
              <dd><time datetime={isoDate(published)}>{formatDate(published)}</time></dd>
            </div>
            {
              updated && updated.valueOf() !== published.valueOf() && (
                <div class="flex gap-1.5">
                  <dt>수정</dt>
                  <dd>
                    <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
                  </dd>
                </div>
              )
            }
            <div class="flex gap-1.5">
              <dt class="sr-only">예상 읽기 시간</dt>
              <dd>약 {minutes}분 분량</dd>
            </div>
          </dl>

          {
            tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li class="rounded-md border border-border bg-surface px-2 py-0.5 text-xs text-muted">
                    #{tag}
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <TableOfContents headings={headings} variant="mobile" class="lg:hidden" />

        <div class="prose ks-guide-body">
          <slot />
        </div>

        <RelatedGuides entry={entry} />

        <div class="mt-12 border-t border-border pt-6">
          <Disclaimer />
        </div>

        <div class="mt-8">
          <a
            href="/guides/"
            class="inline-flex items-center gap-1 text-sm font-bold text-link no-underline hover:underline"
          >
            <span aria-hidden="true">←</span> 공략 목록으로
          </a>
        </div>
      </article>

      <aside class="hidden lg:block">
        <TableOfContents headings={headings} variant="desktop" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* sticky 헤더(약 60px)에 제목이 가리지 않도록 */
  .ks-guide-body :is(h2, h3, h4) {
    scroll-margin-top: 5.5rem;
  }
</style>
