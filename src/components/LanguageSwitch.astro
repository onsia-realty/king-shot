<div class="ks-language inline-flex shrink-0 whitespace-nowrap rounded-lg border border-border bg-surface p-0.5" role="group" aria-label="언어" data-aria-label-ko="언어" data-aria-label-en="Language" data-aria-label-zh-tw="語言">
  <button type="button" data-set-locale="ko" lang="ko" aria-pressed="true" class="rounded-md px-2 py-1.5 text-xs font-bold focus-visible:outline-2 focus-visible:outline-accent">한국어</button>
  <button type="button" data-set-locale="en" lang="en" aria-pressed="false" class="rounded-md px-2 py-1.5 text-xs font-bold focus-visible:outline-2 focus-visible:outline-accent">English</button>
  <button type="button" data-set-locale="zh-TW" lang="zh-TW" aria-pressed="false" class="rounded-md px-2 py-1.5 text-xs font-bold focus-visible:outline-2 focus-visible:outline-accent">繁體中文</button>
</div>

<style>
  button[aria-pressed='true'] { background: var(--ks-raised); color: var(--ks-accent); }
  @media (max-width: 399px) {
    .ks-language { width: 100%; justify-content: center; }
  }
</style>

<script>
  import { getLocale, setLocale, subscribe, isLocaleScope } from '@/lib/locale';

  function renderLocale() {
    const supported = isLocaleScope(window.location.pathname);
    const locale = supported ? getLocale() : 'ko';
    document.documentElement.lang = locale;
    if (!supported) return;
    const suffix = locale.toLowerCase();
    // Only authored translation targets are updated; React island DOM is untouched.
    document.querySelectorAll<HTMLElement>('[data-locale-ko][data-locale-en]').forEach((element) => {
      element.textContent = element.getAttribute(`data-locale-${suffix}`) ?? element.getAttribute('data-locale-en') ?? '';
    });
    for (const attribute of ['aria-label', 'content', 'title', 'alt'] as const) {
      document.querySelectorAll<HTMLElement>(`[data-${attribute}-ko][data-${attribute}-en]`).forEach((element) => {
        element.setAttribute(attribute, element.getAttribute(`data-${attribute}-${suffix}`) ?? element.getAttribute(`data-${attribute}-en`) ?? '');
      });
    }
    document.querySelectorAll<HTMLButtonElement>('[data-set-locale]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.setLocale === locale));
    });
  }

  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-set-locale]') : null;
    const locale = button?.dataset.setLocale;
    if (isLocaleScope(location.pathname) && (locale === 'ko' || locale === 'en' || locale === 'zh-TW')) setLocale(locale);
  });
  subscribe(renderLocale);
  document.addEventListener('astro:page-load', renderLocale);
  renderLocale();
</script>
