---
import LocaleText from '@/components/LocaleText.astro';
import { staticEnglish } from '@/lib/static-translations';
import LanguageSwitch from '@/components/LanguageSwitch.astro';
import { isLocaleScope } from '@/lib/locale';
import KakaoButton from '@/components/KakaoButton.astro';
import { mainNav, isActive, SITE_NAME, KAKAO_OPENCHAT } from '@/data/nav';

const pathname = Astro.url.pathname;
const localeScope = isLocaleScope(pathname);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70"
>
  <div class:list={['mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3 sm:gap-4', localeScope && 'flex-wrap']}>
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 text-lg font-extrabold tracking-tight whitespace-nowrap text-text no-underline hover:text-accent"
    >
      <span aria-hidden="true" class="text-accent">👑</span>
      <span><LocaleText ko={SITE_NAME} en={staticEnglish(SITE_NAME)} /></span>
    </a>

    <div class:list={['flex items-center gap-2 sm:gap-3', localeScope && 'w-full justify-between sm:w-auto sm:justify-end']}>
    {localeScope && <LanguageSwitch />}
    <!-- 데스크톱 네비 -->
    <nav aria-label="주요 메뉴" data-aria-label-ko="주요 메뉴" data-aria-label-en="Main navigation" class:list={['hidden', localeScope ? 'xl:block' : 'md:block']}>
      <ul class="flex items-center gap-1">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item, pathname) ? 'page' : undefined}
                class:list={[
                  'rounded-lg py-2 font-semibold no-underline transition-colors',
                  localeScope ? 'px-2 text-xs' : 'px-3 text-sm',
                  isActive(item, pathname)
                    ? 'bg-raised text-accent'
                    : 'text-muted hover:bg-surface hover:text-text',
                ]}
              >
                <LocaleText ko={item.label} en={staticEnglish(item.label)} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 오픈채팅: 데스크톱은 글자 버튼, 모바일은 메뉴를 열지 않아도 보이는 아이콘 버튼 -->
    <span class:list={['hidden', localeScope ? 'xl:inline-flex' : 'md:inline-flex']}><KakaoButton variant="full" text="오픈채팅" /></span>
    <span class:list={['inline-flex', localeScope ? 'xl:hidden' : 'md:hidden']}><KakaoButton variant="icon" /></span>

    <!-- 모바일 토글: JS 없이 details/summary -->
    <details class:list={['ks-menu relative', localeScope ? 'xl:hidden' : 'md:hidden']}>
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-semibold text-text"
        aria-label="메뉴 열기" data-aria-label-ko="메뉴 열기" data-aria-label-en="Open menu"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <span><LocaleText ko="메뉴" en="Menu" /></span>
      </summary>
      <nav
        aria-label="모바일 메뉴" data-aria-label-ko="모바일 메뉴" data-aria-label-en="Mobile navigation"
        class="absolute right-0 top-[calc(100%+0.5rem)] w-52 rounded-xl border border-border bg-surface p-2 shadow-2xl shadow-black/50"
      >
        <ul class="flex flex-col">
          {
            mainNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item, pathname) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2 text-sm font-semibold no-underline',
                    isActive(item, pathname)
                      ? 'bg-raised text-accent'
                      : 'text-text hover:bg-raised',
                  ]}
                >
                  <LocaleText ko={item.label} en={staticEnglish(item.label)} />
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={KAKAO_OPENCHAT.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${KAKAO_OPENCHAT.label} 참여하기 (새 창 열림)`}
          data-aria-label-ko={`${KAKAO_OPENCHAT.label} 참여하기 (새 창 열림)`}
          data-aria-label-en="Join KakaoTalk Open Chat (opens in a new tab)"
          class="mt-2 block rounded-lg border-t border-border px-3 pt-3 text-sm font-semibold text-kakao no-underline hover:text-kakao"
        >
          <LocaleText ko="카카오톡 오픈채팅 참여" en="Join KakaoTalk Open Chat" />
        </a>
      </nav>
    </details>
    </div>
  </div>
</header>

<style>
  .ks-menu > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script is:inline>
  // 메뉴 밖 클릭 / ESC 로 닫기 (details 기본 동작 보완)
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.ks-menu[open]').forEach((d) => {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('details.ks-menu[open]').forEach((d) => d.removeAttribute('open'));
  });
</script>
