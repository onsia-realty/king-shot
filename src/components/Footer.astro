---
import Disclaimer from '@/components/Disclaimer.astro';
import KakaoButton from '@/components/KakaoButton.astro';
import { mainNav, footerNav, SITE_NAME, KAKAO_OPENCHAT } from '@/data/nav';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <nav aria-label="사이트 메뉴">
        <h2 class="mb-3 text-sm font-bold text-text">콘텐츠</h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            mainNav.map((item) => (
              <li>
                <a class="text-sm text-muted no-underline hover:text-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="사이트 정보">
        <h2 class="mb-3 text-sm font-bold text-text">사이트</h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            footerNav.map((item) => (
              <li>
                <a class="text-sm text-muted no-underline hover:text-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section aria-labelledby="footer-community" class="sm:col-span-2 lg:col-span-1">
        <h2 id="footer-community" class="mb-3 text-sm font-bold text-text">커뮤니티</h2>
        <p class="text-sm font-semibold text-text">{KAKAO_OPENCHAT.roomName}</p>
        <p class="mt-1 text-sm text-muted">{KAKAO_OPENCHAT.blurb}</p>
        <KakaoButton variant="full" text="오픈채팅 참여" class="mt-3" />
      </section>
    </div>

    <div class="mt-8 border-t border-border pt-6">
      <Disclaimer />
      <p class="mt-4 text-xs text-muted">
        © {year} {SITE_NAME}. 비공식 팬 사이트.
      </p>
    </div>
  </div>
</footer>
