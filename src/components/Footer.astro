---
import Disclaimer from '@/components/Disclaimer.astro';
import { mainNav, footerNav, SITE_NAME } from '@/data/nav';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-2">
      <nav aria-label="사이트 메뉴">
        <h2 class="mb-3 text-sm font-bold text-text">콘텐츠</h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            mainNav.map((item) => (
              <li>
                <a class="text-sm text-muted no-underline hover:text-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="사이트 정보">
        <h2 class="mb-3 text-sm font-bold text-text">사이트</h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            footerNav.map((item) => (
              <li>
                <a class="text-sm text-muted no-underline hover:text-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-border pt-6">
      <Disclaimer />
      <p class="mt-4 text-xs text-muted">
        © {year} {SITE_NAME}. 비공식 팬 사이트.
      </p>
    </div>
  </div>
</footer>
