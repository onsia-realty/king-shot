---
import LocaleText from '@/components/LocaleText.astro';
import { staticEnglish } from '@/lib/static-translations';
import Disclaimer from '@/components/Disclaimer.astro';
import KakaoButton from '@/components/KakaoButton.astro';
import { mainNav, footerNav, KAKAO_OPENCHAT } from '@/data/nav';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <nav aria-label="사이트 메뉴" data-aria-label-ko="사이트 메뉴" data-aria-label-en="Site navigation">
        <h2 class="mb-3 text-sm font-bold text-text"><LocaleText ko="콘텐츠" en="Content" /></h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            mainNav.map((item) => (
              <li>
                <a class="text-sm text-muted no-underline hover:text-link" href={item.href}>
                  <LocaleText ko={item.label} en={staticEnglish(item.label)} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="사이트 정보" data-aria-label-ko="사이트 정보" data-aria-label-en="Site information">
        <h2 class="mb-3 text-sm font-bold text-text"><LocaleText ko="사이트" en="Site" /></h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            footerNav.map((item) => (
              <li>
                <a class="text-sm text-muted no-underline hover:text-link" href={item.href}>
                  <LocaleText ko={item.label} en={staticEnglish(item.label)} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section aria-labelledby="footer-community" class="sm:col-span-2 lg:col-span-1">
        <h2 id="footer-community" class="mb-3 text-sm font-bold text-text"><LocaleText ko="커뮤니티" en="Community" /></h2>
        <p class="text-sm font-semibold text-text"><LocaleText ko={KAKAO_OPENCHAT.roomName} en={staticEnglish(KAKAO_OPENCHAT.roomName)} /></p>
        <p class="mt-1 text-sm text-muted"><LocaleText ko={KAKAO_OPENCHAT.blurb} en={staticEnglish(KAKAO_OPENCHAT.blurb)} /></p>
        <KakaoButton variant="full" text="오픈채팅 참여" class="mt-3" />
      </section>
    </div>

    <div class="mt-8 border-t border-border pt-6">
      <Disclaimer />
      <p class="mt-4 text-xs text-muted">
        © {year} 킹샷공략.xyz · <LocaleText ko="비공식 팬 사이트 · 무단 복제·재배포 금지" en="Unofficial fan site · No unauthorized copying or redistribution" />
      </p>
    </div>
  </div>
</footer>
