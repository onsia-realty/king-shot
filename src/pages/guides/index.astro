---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import GuideCard from '@/components/GuideCard.astro';
import GuideSearch from '@/components/islands/GuideSearch';
import {
  CATEGORIES,
  CATEGORY_EMOJI,
  categoryHref,
  guideHref,
  sortByPublished,
} from '@/lib/guides';
import { SITE_NAME } from '@/data/nav';

const guides = sortByPublished(await getCollection('guides', ({ data }) => !data.draft));

const counts = new Map<string, number>();
for (const g of guides) counts.set(g.data.category, (counts.get(g.data.category) ?? 0) + 1);

const site = Astro.site ?? new URL('https://example.com');
const description =
  '킹샷 공략 전체 목록. 입문 로드맵부터 영웅·전투·건설·이벤트·연맹·과금·이민까지 카테고리별로 정리했습니다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${SITE_NAME} 공략 목록`,
  numberOfItems: guides.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: guides.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.data.title,
    url: new URL(guideHref(g), site).href,
  })),
};
---

<BaseLayout title="공략" description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumb items={[{ label: '홈', href: '/' }, { label: '공략' }]} class="mb-6" />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl">킹샷 공략</h1>
      <p class="mt-3 max-w-2xl text-muted">
        직접 굴려보고 확인한 내용만 씁니다. 급하면 카테고리로 바로 들어가고, 찾는 게 뚜렷하면 검색을
        쓰세요.
      </p>
    </header>

    <nav aria-label="카테고리" class="mb-8">
      <ul class="flex flex-wrap gap-2">
        {
          CATEGORIES.map((category) => (
            <li>
              <a
                href={categoryHref(category)}
                class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-semibold text-text no-underline transition-colors hover:border-accent/50 hover:bg-raised hover:text-accent"
              >
                <span aria-hidden="true">{CATEGORY_EMOJI[category]}</span>
                {category}
                <span class="text-xs text-muted">{counts.get(category) ?? 0}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <GuideSearch client:load total={guides.length} />

    {
      guides.length === 0 ? (
        <p class="rounded-xl border border-border bg-surface p-8 text-center text-muted">
          아직 올라온 공략이 없습니다.
        </p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {guides.map((entry) => (
            <li data-guide-item>
              <GuideCard entry={entry} headingLevel="h2" searchable />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
