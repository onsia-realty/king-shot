---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RarityBadge from '@/components/RarityBadge.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import { rarityLabel } from '@/lib/labels';

export async function getStaticPaths() {
  const pets = await getCollection('pets');
  return pets.map((pet) => ({ params: { slug: pet.id }, props: { pet } }));
}

interface Props {
  pet: CollectionEntry<'pets'>;
}

const { pet } = Astro.props;
const d = pet.data;
const { Content } = await render(pet);

const all = (await getCollection('pets')).sort((a, b) => a.data.order - b.data.order);
const sameRarity = all.filter((p) => p.id !== pet.id && p.data.rarity === d.rarity).slice(0, 6);

const hasSkills = d.skills.length > 0;

const rarityVar = `var(--ks-rarity-${d.rarity.toLowerCase()})`;
const placeholderStyle = `background-image: linear-gradient(150deg, color-mix(in oklab, ${rarityVar} 45%, transparent), color-mix(in oklab, ${rarityVar} 8%, transparent) 65%, transparent); color: ${rarityVar};`;

const RARITY_RING = {
  SSR: 'ring-rarity-ssr',
  SR: 'ring-rarity-sr',
  R: 'ring-rarity-r',
  N: 'ring-rarity-n',
} as const;

const title = `${d.name} (${d.nameEn})`;
const description = `킹샷 펫 ${d.name}(${d.nameEn}) — ${rarityLabel(d.rarity)} 등급. ${d.summary}`;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[{ label: '홈', href: '/' }, { label: '펫', href: '/pets/' }, { label: d.name }]}
      class="mb-6"
    />

    <header class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <div
        class:list={[
          'flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-xl text-3xl font-extrabold',
          d.icon ? ['bg-raised ring-2 ring-inset', RARITY_RING[d.rarity]] : 'border border-border',
        ]}
        style={d.icon ? undefined : placeholderStyle}
        aria-hidden={d.icon ? undefined : 'true'}
      >
        {d.icon ? (
          <Image
            src={d.icon}
            alt={`${d.name} (${d.nameEn}) 아이콘`}
            width={256}
            height={256}
            loading="eager"
            decoding="async"
            class="size-20 object-cover"
          />
        ) : (
          d.name.trim().slice(0, 1)
        )}
      </div>

      <div>
        <h1 class="text-3xl font-extrabold sm:text-4xl">
          {d.name} <span class="text-muted">({d.nameEn})</span>
        </h1>
        <div class="mt-3">
          <RarityBadge rarity={d.rarity} />
        </div>
      </div>
    </header>

    <p class="mt-5 rounded-xl border border-border bg-surface px-4 py-3 text-muted">{d.summary}</p>

    {hasSkills ? (
      <section class="mt-10">
        <h2 class="text-xl font-bold">스킬</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          {d.skills.map((skill) => (
            <li class="rounded-xl border border-border bg-surface p-4">
              <h3 class="font-bold">{skill.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{skill.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <p class="mt-8 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
        스킬 정보는 게임 내 확인 후 추가됩니다. 추측한 수치를 올려두지 않으려고 비워 뒀습니다.
      </p>
    )}

    <div class="prose mt-10">
      <Content />
    </div>

    {sameRarity.length > 0 && (
      <section class="mt-12 border-t border-border pt-8">
        <h2 class="text-xl font-bold">같은 {rarityLabel(d.rarity)} 등급 펫</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {sameRarity.map((p) => (
            <li>
              <a
                href={`/pets/${p.id}/`}
                class="flex items-baseline gap-2 rounded-xl border border-border bg-surface px-4 py-3 no-underline transition-colors hover:border-accent/50 hover:bg-raised"
              >
                <span class="font-bold text-text">{p.data.name}</span>
                <span class="text-xs text-muted">{p.data.nameEn}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-10 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
