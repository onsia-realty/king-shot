---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';

import { RARITY_ORDER, rarityLabel, type Rarity } from '@/lib/labels';

const pets = (await getCollection('pets')).sort((a, b) => a.data.order - b.data.order);

const groups = RARITY_ORDER.map((rarity) => ({
  rarity,
  items: pets.filter((p) => p.data.rarity === rarity),
})).filter((g) => g.items.length > 0);

const site = Astro.site ?? new URL('https://example.com');

const title = '킹샷 펫 도감';
const description = `킹샷 펫 ${pets.length}종을 등급별로 정리했습니다. 어떤 펫을 먼저 키울지 고민될 때 참고하세요.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: pets.length,
  itemListElement: pets.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${p.data.name} (${p.data.nameEn})`,
    url: new URL(`/pets/${p.id}/`, site).href,
  })),
};

const rarityVar = (r: Rarity) => `var(--ks-rarity-${r.toLowerCase()})`;

const RARITY_RING: Record<Rarity, string> = {
  SSR: 'ring-rarity-ssr',
  SR: 'ring-rarity-sr',
  R: 'ring-rarity-r',
  N: 'ring-rarity-n',
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb items={[{ label: '홈', href: '/' }, { label: '펫' }]} class="mb-6" />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl">펫 도감</h1>
      <p class="mt-3 max-w-2xl text-muted">
        킹샷 펫 {pets.length}종을 등급별로 묶었습니다. 등급이 높을수록 버프 폭이 커지지만, 낮은 등급
        중에도 특정 시기에만 값을 하는 펫이 섞여 있습니다.
      </p>
    </header>

    {
      groups.map((group) => (
        <section class="mb-10">
          <div class="mb-4 flex items-center gap-2.5">
            <h2 class="text-xl font-bold">{rarityLabel(group.rarity)} 등급</h2>
            <span class="text-sm font-semibold text-muted">{group.rarity}</span>
            <span class="text-sm text-muted">{group.items.length}종</span>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((pet) => (
              <article class="group relative flex flex-col gap-2 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/50 hover:bg-raised">
                <div class="flex items-center gap-2.5">
                  {pet.data.icon ? (
                    <Image
                      src={pet.data.icon}
                      alt={`${pet.data.name} (${pet.data.nameEn}) 아이콘`}
                      width={128}
                      height={128}
                      loading="lazy"
                      decoding="async"
                      class:list={[
                        'size-12 shrink-0 rounded-lg bg-raised object-cover ring-2 ring-inset',
                        RARITY_RING[group.rarity],
                      ]}
                    />
                  ) : (
                    <span
                      aria-hidden="true"
                      class="inline-block size-2.5 shrink-0 rounded-full"
                      style={`background: ${rarityVar(group.rarity)}`}
                    />
                  )}
                  <h3 class="text-base font-bold leading-tight">
                    <a
                      href={`/pets/${pet.id}/`}
                      class="text-text no-underline after:absolute after:inset-0 hover:text-accent"
                    >
                      {pet.data.name}
                    </a>
                    <span class="ml-1.5 text-xs font-normal text-muted">{pet.data.nameEn}</span>
                  </h3>
                </div>
                <p class="text-sm leading-relaxed text-muted">{pet.data.summary}</p>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <div class="mt-12 border-t border-border pt-6">
      <p class="mb-3 text-sm text-muted">
        펫 스킬 수치는 게임 내 확인 후 순차적으로 채웁니다.
      </p>
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
