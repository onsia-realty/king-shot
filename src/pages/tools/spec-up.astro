---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import SpecUpCalculator from '@/components/islands/SpecUpCalculator';
import { TOOLS } from '@/data/tools';
import { BASE_PACKAGE_PRICE_KRW } from '@/data/package-ref';

const otherTools = TOOLS.filter((t) => t.href !== '/tools/spec-up/');
const basePrice = BASE_PACKAGE_PRICE_KRW.toLocaleString('ko-KR');

const title = '스펙업 계산기';
const description =
  '킹샷 영웅 장비 레벨·마스터리, 영주 장비 티어, 영주 보석 레벨을 올리는 데 드는 비용을 패키지 기준 원화로 환산하고, 성능 1%를 올리는 데 얼마가 드는지 비교합니다.';

const faq = [
  {
    q: '비용은 어떻게 계산하나요?',
    a: `구간마다 필요한 재료 수량에 아이템 단가를 곱해 더합니다. 단가는 ${basePrice}원 기준 패키지에 그 아이템이 몇 개 들어 있는지로 정하고, 세대를 바꾸면 단가도 바뀝니다. 비단·금사는 세트 패키지를 반으로 나눠 ${(BASE_PACKAGE_PRICE_KRW / 2).toLocaleString('ko-KR')}원 기준으로 잡습니다.`,
  },
  {
    q: '1%당 비용은 무엇인가요?',
    a: '성능을 1%p 올리는 데 드는 예상 비용입니다. 낮을수록 같은 돈으로 더 많이 오르는 구간이라, 어디부터 투자할지 정할 때 이 값을 비교하면 됩니다.',
  },
  {
    q: '영웅 장비 120·160·200레벨은 왜 비싼가요?',
    a: '101·120·140·160·180·200레벨은 승급 단계라 EXP 대신 미스릴과 신화 장비가 들어갑니다. 대신 120·160·200레벨은 원정 효과 승급 보너스(+20·+30·+50%)가 붙어서 1%당 비용이 생각보다 나쁘지 않을 수 있습니다.',
  },
  {
    q: '마스터리 성능은 왜 장비 레벨에 따라 달라지나요?',
    a: '마스터리 한 단계는 장비 스탯의 10%를 더하는 증폭이라서, 목표 장비 레벨이 높을수록 같은 망치로 오르는 성능이 커집니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    inLanguage: 'ko-KR',
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'KRW',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[
        { label: '홈', href: '/' },
        { label: '계산기', href: '/tools/' },
        { label: '스펙업 계산기' },
      ]}
      class="mb-6"
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl">스펙업 계산기</h1>
      <p class="mt-3 max-w-2xl text-muted">
        영웅 장비는 EXP와 망치로 레벨·마스터리를 올리고, 영주 장비는 비단·금사·스케치로 티어를
        올리고, 영주 보석은 매뉴얼·도면으로 레벨을 올립니다. 현재와 목표를 고르면 드는 비용을{' '}
        {basePrice}원 패키지 기준 원화로 바꾸고, 성능이 몇 % 오르는지와 1%당 비용을 같이
        보여줍니다. 효율표에서 구간별 1%당 비용을 비교해 투자 순서를 정하세요.
      </p>
    </header>

    <SpecUpCalculator client:load />

    <section class="mt-12">
      <h2 class="text-xl font-bold">자주 묻는 질문</h2>
      <dl class="mt-3 space-y-3">
        {
          faq.map((f) => (
            <div class="rounded-xl border border-border bg-surface px-4 py-3">
              <dt class="font-bold">{f.q}</dt>
              <dd class="mt-1 text-sm text-muted">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">데이터 범위와 한계</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          모든 성능 수치는 원정 효과 기준입니다. 영주 장비·보석은 원본 표기대로 2배로 계산합니다.
        </li>
        <li>
          비용은 상시 기준 패키지로 환산한 값이라 이벤트 패키지를 쓰면 실제로는 더 쌀 수 있습니다.
        </li>
        <li>
          순금 6/7/8·진급·9/10 세대는 패키지 구성이 예측치라 비용도 예측치입니다. 신화 장비는 영웅
          장비 상자 100개당 1개로 봅니다.
        </li>
        <li>
          영주 장비 성능표는 레전드 T1~신화 T2★까지만 실측값이 있고, 그 앞뒤 티어는 2.5%씩 빼거나
          더해 추정합니다.
        </li>
        <li>게임 내 표기와 다르면 게임 쪽을 따라 주세요.</li>
        <li>
          출처:
          <a
            href="https://kshot-lab.com/tools/progress"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link hover:text-link-hover">kshot-lab.com</a
          > 공개 데이터 (2026-10-09 수집)
        </li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">다른 계산기</h2>
      <ul class="mt-3 space-y-2">
        {
          otherTools.map((tool) => (
            <li class="rounded-xl border border-border bg-surface px-4 py-3">
              <a href={tool.href} class="font-bold hover:text-accent">
                {tool.label}
              </a>
              <p class="mt-1 text-sm text-muted">{tool.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
