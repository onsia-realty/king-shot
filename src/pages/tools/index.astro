---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import { TOOLS } from '@/data/tools';

const site = Astro.site ?? new URL('https://example.com');

const title = '킹샷 계산기';
const description =
  '킹샷 성장에 필요한 계산을 한곳에 모았습니다. 영웅 승급 파편, 영웅 비교, 건물 업그레이드 비용까지 숫자로 확인하세요.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: TOOLS.length,
  itemListElement: TOOLS.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: tool.label,
    url: new URL(tool.href, site).href,
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb items={[{ label: '홈', href: '/' }, { label: '계산기' }]} class="mb-6" />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl">계산기</h1>
      <p class="mt-3 max-w-2xl text-muted">
        감으로 때려 맞히던 수치를 직접 넣어 보는 도구들입니다. 파편이 몇 개 더 필요한지, 이번
        업그레이드에 자원이 얼마나 들어가는지 미리 확인하고 투자 순서를 정하세요.
      </p>
    </header>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        TOOLS.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex h-full flex-col rounded-xl border border-border bg-surface p-5 no-underline transition-colors hover:border-accent/60 hover:bg-raised"
            >
              <span class="text-lg font-bold text-text group-hover:text-accent">{tool.label}</span>
              <span class="mt-2 text-sm text-muted">{tool.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 border-t border-border pt-6">
      <p class="mb-3 text-sm text-muted">
        계산 결과는 공개된 수치표를 바탕으로 한 추정입니다. 게임 업데이트나 개인 버프에 따라
        실제 값과 차이가 날 수 있으니 참고용으로 쓰세요.
      </p>
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
