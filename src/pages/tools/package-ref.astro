---
import LocaleText from '@/components/LocaleText.astro';
import { staticEnglish, staticTraditionalChinese } from '@/lib/static-translations';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import PackageRefTable from '@/components/islands/PackageRefTable';
import { TOOLS } from '@/data/tools';
import { BASE_PACKAGE_PRICE_KRW } from '@/data/package-ref';

const otherTools = TOOLS.filter((t) => t.href !== '/tools/package-ref/');
const basePrice = BASE_PACKAGE_PRICE_KRW.toLocaleString('ko-KR');

const title = '패키지 기준표';
const description = `킹샷 순금 세대별로 ${basePrice}원 기준 패키지에 망치·영웅장비 EXP·순금·비단·금사 등이 몇 개 들어 있는지, 아이템 하나가 몇 원꼴인지 정리한 표입니다.`;

const faq = [
  {
    qEn: `How is the unit price calculated?`,
    qZhTW: `單價如何計算？`,
    aEn: `The reference pack price of ₩${basePrice} is divided by the item quantity for that generation. For example, the Truegold 1/2/3 pack contains 12 hammers, giving ₩625 per hammer.`,
    aZhTW: `以參考禮包價格 ₩${basePrice} 除以該世代的道具數量。例如精金 1／2／3 禮包有 12 個錘子，每個為 ₩625。`,
    q: '개당 단가는 어떻게 계산하나요?',
    a: `기준 패키지 가격 ${basePrice}원을 그 세대 패키지에 들어 있는 수량으로 나눈 값입니다. 예를 들어 순금 1/2/3 세대 망치는 12개라서 개당 625원입니다.`,
  },
  {
    qEn: `What does a forecast generation mean?`,
    qZhTW: `預測世代是什麼意思？`,
    aEn: `Observed pack contents are not available yet, so values are estimated from the growth of earlier generations. Truegold 9/10 keeps charm designs, satin and gold thread at Advancement quantities, which may understate actual contents.`,
    aZhTW: `尚無實測禮包內容，因此依前幾代的成長幅度估算。精金 9／10 的寶石設計圖、緞料與金線沿用晉階世代數量，可能低估實際內容。`,
    q: '예측 배지가 붙은 세대는 뭔가요?',
    a: '아직 실측 패키지 구성을 확보하지 못해 앞 세대의 증가 폭으로 추정한 값입니다. 순금 9/10은 보석 도면·비단·금사를 진급 값 그대로 두어 실제보다 낮을 수 있습니다.',
  },
  {
    qEn: `How should I use this table?`,
    qZhTW: `如何使用這張表？`,
    aEn: `Use it as a baseline for evaluating packs. Convert each item to its reference unit value and add the results to compare total value with the reference price.`,
    aZhTW: `將它作為評估禮包的基準。把每項道具換算為參考單價後加總，再將總價值與參考價格比較。`,
    q: '이 표를 어디에 쓰나요?',
    a: '패키지가 값어치를 하는지 따질 때 기준선으로 씁니다. 패키지 구성품을 이 단가로 환산해 합하면 기준가 대비 몇 배 효율인지 볼 수 있습니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    inLanguage: 'ko-KR',
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'KRW',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout titleEn={staticEnglish(title)} titleZhTW={staticTraditionalChinese(title)} descriptionEn={`Compare the contents of ₩${basePrice} reference packs by Kingshot Truegold generation, including hammers, hero gear EXP, Truegold, satin and gold thread, with unit prices.`} descriptionZhTW={`依 Kingshot 精金世代比較 ₩${basePrice} 參考禮包中的錘子、英雄裝備 EXP、精金、緞料與金線數量及單價。`} title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[
        { label: '홈', href: '/' },
        { label: '계산기', href: '/tools/' },
        { label: '패키지 기준표' },
      ]}
      class="mb-6"
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl"><LocaleText ko={`패키지 기준표`} en={`Package Reference`} zhTW={`禮包參考表`} /></h1>
      <p class="mt-3 max-w-2xl text-muted">
        <LocaleText ko={`${basePrice}원짜리 기준 패키지 한 개에 아이템이 몇 개 들어 있는지 순금 세대별로 모았습니다. 세대를 고르면 아이템 하나가 몇 원꼴인지 같이 나옵니다. 패키지를 살지 말지 따질 때 이 단가를 기준선으로 쓰세요.`} en={`Compare the contents of a ₩${basePrice} reference pack across Truegold generations. Select a generation to see each item’s unit price in KRW and use it as a baseline when evaluating packs.`} zhTW={`依精金世代比較 ₩${basePrice} 參考禮包的內容。選擇世代即可查看各道具的韓元單價，作為評估禮包的基準。`} />
      </p>
    </header>

    <PackageRefTable client:load />

    <section class="mt-12">
      <h2 class="text-xl font-bold"><LocaleText ko={`자주 묻는 질문`} en={`Frequently Asked Questions`} zhTW={`常見問題`} /></h2>
      <dl class="mt-3 space-y-3">
        {
          faq.map((f) => (
            <div class="rounded-xl border border-border bg-surface px-4 py-3">
              <dt class="font-bold"><LocaleText ko={f.q} en={f.qEn} zhTW={f.qZhTW} /></dt>
              <dd class="mt-1 text-sm text-muted"><LocaleText ko={f.a} en={f.aEn} zhTW={f.aZhTW} /></dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold"><LocaleText ko={`데이터 범위와 한계`} en={`Data Coverage and Limitations`} zhTW={`資料範圍與限制`} /></h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><LocaleText ko={`순금 1/2/3, 4/5, 전쟁 아카데미는 실측 구성이고, 그 뒤 세 세대는 예측치입니다.`} en={`Truegold 1/2/3, 4/5 and War Academy use observed pack contents. The following three generations are forecasts.`} zhTW={`精金 1／2／3、4／5 與戰爭學院採用實測禮包內容，後續三個世代則為預測值。`} /></li>
        <li><LocaleText ko={`게임 내 패키지 구성이 바뀌거나 이 표와 다르면 게임 쪽을 따라 주세요.`} en={`If pack contents change or differ from this table, follow the information shown in the game.`} zhTW={`若遊戲內禮包內容變更或與表格不同，請以遊戲內資訊為準。`} /></li>
        <li>
          <LocaleText ko={`출처:`} en={`Source:`} zhTW={`來源：`} />
          <a
            href="https://kshot-lab.com/tools/package-ref"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link hover:text-link-hover">kshot-lab.com</a
          > <LocaleText ko={`공개 데이터 (2026-10-09 수집)`} en={`Public data (collected October 9, 2026)`} zhTW={`公開資料（2026 年 10 月 9 日擷取）`} />
        </li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold"><LocaleText ko={`다른 계산기`} en={`Related Tools`} zhTW={`其他計算工具`} /></h2>
      <ul class="mt-3 space-y-2">
        {
          otherTools.map((tool) => (
            <li class="rounded-xl border border-border bg-surface px-4 py-3">
              <a href={tool.href} class="font-bold hover:text-accent">
                <LocaleText ko={tool.label} en={staticEnglish(tool.label)} zhTW={staticTraditionalChinese(tool.label)} />
              </a>
              <p class="mt-1 text-sm text-muted"><LocaleText ko={tool.summary} en={staticEnglish(tool.summary)} zhTW={staticTraditionalChinese(tool.summary)} /></p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
