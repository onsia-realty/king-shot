---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import PackageRefTable from '@/components/islands/PackageRefTable';
import { TOOLS } from '@/data/tools';
import { BASE_PACKAGE_PRICE_KRW } from '@/data/package-ref';

const otherTools = TOOLS.filter((t) => t.href !== '/tools/package-ref/');
const basePrice = BASE_PACKAGE_PRICE_KRW.toLocaleString('ko-KR');

const title = '패키지 기준표';
const description = `킹샷 순금 세대별로 ${basePrice}원 기준 패키지에 망치·영웅장비 EXP·순금·비단·금사 등이 몇 개 들어 있는지, 아이템 하나가 몇 원꼴인지 정리한 표입니다.`;

const faq = [
  {
    q: '개당 단가는 어떻게 계산하나요?',
    a: `기준 패키지 가격 ${basePrice}원을 그 세대 패키지에 들어 있는 수량으로 나눈 값입니다. 예를 들어 순금 1/2/3 세대 망치는 12개라서 개당 625원입니다.`,
  },
  {
    q: '예측 배지가 붙은 세대는 뭔가요?',
    a: '아직 실측 패키지 구성을 확보하지 못해 앞 세대의 증가 폭으로 추정한 값입니다. 순금 9/10은 보석 도면·비단·금사를 진급 값 그대로 두어 실제보다 낮을 수 있습니다.',
  },
  {
    q: '이 표를 어디에 쓰나요?',
    a: '패키지가 값어치를 하는지 따질 때 기준선으로 씁니다. 패키지 구성품을 이 단가로 환산해 합하면 기준가 대비 몇 배 효율인지 볼 수 있습니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    inLanguage: 'ko-KR',
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'KRW',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[
        { label: '홈', href: '/' },
        { label: '계산기', href: '/tools/' },
        { label: '패키지 기준표' },
      ]}
      class="mb-6"
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl">패키지 기준표</h1>
      <p class="mt-3 max-w-2xl text-muted">
        {basePrice}원짜리 기준 패키지 한 개에 아이템이 몇 개 들어 있는지 순금 세대별로 모았습니다.
        세대를 고르면 아이템 하나가 몇 원꼴인지 같이 나옵니다. 패키지를 살지 말지 따질 때 이
        단가를 기준선으로 쓰세요.
      </p>
    </header>

    <PackageRefTable client:load />

    <section class="mt-12">
      <h2 class="text-xl font-bold">자주 묻는 질문</h2>
      <dl class="mt-3 space-y-3">
        {
          faq.map((f) => (
            <div class="rounded-xl border border-border bg-surface px-4 py-3">
              <dt class="font-bold">{f.q}</dt>
              <dd class="mt-1 text-sm text-muted">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">데이터 범위와 한계</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>순금 1/2/3, 4/5, 전쟁 아카데미는 실측 구성이고, 그 뒤 세 세대는 예측치입니다.</li>
        <li>게임 내 패키지 구성이 바뀌거나 이 표와 다르면 게임 쪽을 따라 주세요.</li>
        <li>
          출처:
          <a
            href="https://kshot-lab.com/tools/package-ref"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link hover:text-link-hover">kshot-lab.com</a
          > 공개 데이터 (2026-10-09 수집)
        </li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">다른 계산기</h2>
      <ul class="mt-3 space-y-2">
        {
          otherTools.map((tool) => (
            <li class="rounded-xl border border-border bg-surface px-4 py-3">
              <a href={tool.href} class="font-bold hover:text-accent">
                {tool.label}
              </a>
              <p class="mt-1 text-sm text-muted">{tool.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
