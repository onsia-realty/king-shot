---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import SpecUpRoadmap from '@/components/islands/SpecUpRoadmap';
import { TOOLS } from '@/data/tools';
import { BASE_PACKAGE_PRICE_KRW } from '@/data/package-ref';
import { ROADMAP_LIMIT } from '@/data/spec-up-roadmap';

const otherTools = TOOLS.filter((t) => t.href !== '/tools/spec-up-roadmap/');
const basePrice = BASE_PACKAGE_PRICE_KRW.toLocaleString('ko-KR');

const title = '스펙업 로드맵';
const description =
  '킹샷 보병·궁병·기병의 영웅 장비, 마스터리, 영주 장비, 영주 보석 상태를 입력하면 다음 강화 후보를 전부 비교해 성능 대비 비용이 가장 싼 순서로 추천합니다.';

const faq = [
  {
    q: '추천 순서는 어떻게 정하나요?',
    a: `장비마다 다음 1~2단계 강화를 후보로 만들고, 오르는 성능에 스탯 가중치를 곱한 값을 비용으로 나눠 점수를 냅니다. 점수가 높은 순서로 ${ROADMAP_LIMIT}개까지 보여줍니다. 비용은 ${basePrice}원 기준 패키지로 환산한 값이고, 스펙업 계산기와 같은 계산식을 씁니다.`,
  },
  {
    q: '가중치는 무엇을 뜻하나요?',
    a: '체력과 파괴력에 1.1배, 공격과 방어에 1.0배를 곱합니다. 같은 1%라도 체력·파괴력을 조금 더 쳐 준다는 뜻입니다. 영주 장비는 공격·방어, 영주 보석은 체력·파괴력 두 가중치의 평균을 씁니다.',
  },
  {
    q: '곰 우선 모드는 무엇이 다른가요?',
    a: '곰 사냥은 궁병 딜이 핵심이라 궁병 장비만 보고, 체력·방어 가중치를 0으로 둡니다. 그래서 헬멧·신발(파괴력)과 공격 승급 보너스가 붙는 구간, 영주 장비·보석이 주로 남습니다.',
  },
  {
    q: '입력한 정보는 어디에 저장되나요?',
    a: '이 브라우저의 localStorage에만 저장되고 서버로 보내지 않습니다. 사생활 보호 모드처럼 저장이 막힌 환경이면 새로고침할 때 예시로 돌아갑니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    inLanguage: 'ko-KR',
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'KRW',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[
        { label: '홈', href: '/' },
        { label: '계산기', href: '/tools/' },
        { label: '스펙업 로드맵' },
      ]}
      class="mb-6"
    />

    <header class="mb-8">
      <h1 class="text-3xl font-extrabold sm:text-4xl">스펙업 로드맵</h1>
      <p class="mt-3 max-w-2xl text-muted">
        병종별 영웅 장비 레벨·마스터리, 영주 장비 티어, 영주 보석 레벨을 입력하면 지금 상태에서 올릴
        수 있는 다음 단계를 전부 비교해 돈 대비 성능이 가장 잘 오르는 순서로 정리합니다. 무엇부터
        올릴지 고민될 때 위에서부터 차례로 투자하면 됩니다. 입력 전에는 예시 캐릭터 기준 결과가
        보입니다.
      </p>
    </header>

    <SpecUpRoadmap client:load />

    <section class="mt-12">
      <h2 class="text-xl font-bold">자주 묻는 질문</h2>
      <dl class="mt-3 space-y-3">
        {
          faq.map((f) => (
            <div class="rounded-xl border border-border bg-surface px-4 py-3">
              <dt class="font-bold">{f.q}</dt>
              <dd class="mt-1 text-sm text-muted">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">데이터 범위와 한계</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          지금 상태에서 다음 1~2단계만 비교합니다. 영웅 장비는 100레벨 전이면 100까지 한 번에, 그
          뒤는 승급 레벨 단위로 끊습니다.
        </li>
        <li>
          가중치는 원본 사이트 기준값이라 실제 전투 가치와 다를 수 있습니다. 영웅 스킬, 병사 티어,
          연구 같은 다른 성장 요소는 넣지 않습니다.
        </li>
        <li>
          비용은 상시 기준 패키지로 환산한 값이라 이벤트 패키지를 쓰면 실제로는 더 쌀 수 있습니다.
          순금 6/7/8·진급·9/10 세대는 패키지 구성이 예측치라 비용도 예측치입니다.
        </li>
        <li>게임 내 표기와 다르면 게임 쪽을 따라 주세요.</li>
        <li>
          출처:
          <a
            href="https://kshot-lab.com/tools/roadmap"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link hover:text-link-hover">kshot-lab.com</a
          > 공개 데이터 (2026-10-09 수집)
        </li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">다른 계산기</h2>
      <ul class="mt-3 space-y-2">
        {
          otherTools.map((tool) => (
            <li class="rounded-xl border border-border bg-surface px-4 py-3">
              <a href={tool.href} class="font-bold hover:text-accent">
                {tool.label}
              </a>
              <p class="mt-1 text-sm text-muted">{tool.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
