---
import LocaleText from '@/components/LocaleText.astro';
import { staticEnglish } from '@/lib/static-translations';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import BuildingCalculator from '@/components/islands/BuildingCalculator';
import TemperedTruegoldGuide from '@/components/TemperedTruegoldGuide.astro';
import { TOOLS } from '@/data/tools';

const otherTools = TOOLS.filter((t) => t.href !== '/tools/building-calculator/');

const title = '순금·건설 비용 계산기';
const description =
  '도시센터의 현재 단계와 목표 단계를 선택하면 단계별 순금·담금질 순금과 건설 시간을 계산합니다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  inLanguage: 'ko-KR',
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'KRW',
  },
};
---

<BaseLayout titleEn={staticEnglish(title)} descriptionEn={`Calculate Town Center upgrade costs and time for each selected step in Kingshot, including Truegold, Tempered Truegold, construction speed, pet buffs and the construction decree.`} fullTitle="킹샷 순금 계산기 — 업그레이드 재료·건설 시간 계산" description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6 sm:py-10">
    <Breadcrumb
      items={[
        { label: '홈', href: '/' },
        { label: '계산기', href: '/tools/' },
        { label: '순금·건설 비용 계산기' },
      ]}
      class="mb-4"
    />

    <header class="mb-5">
      <h1 class="text-2xl font-extrabold sm:text-4xl"><LocaleText ko={`순금·건설 비용 계산기`} en={`Truegold & Building Calculator`} /></h1>
      <p class="mt-2 max-w-2xl text-sm text-muted sm:text-base">
        <LocaleText ko={`도시센터를 어디까지 올릴까요? 현재 레벨과 목표를 고르면 단계별 순금과 건설 시간을 바로 확인할 수 있어요.`} en={`How far will you upgrade your Town Center? Select current and target levels to see Truegold costs and construction time for each step.`} />
      </p>
    </header>

    <BuildingCalculator client:load />

    <TemperedTruegoldGuide />

    <section class="mt-12">
      <h2 class="text-xl font-bold"><LocaleText ko={`다른 계산기`} en={`Related Tools`} /></h2>
      <ul class="mt-3 space-y-2">
        {
          otherTools.map((tool) => (
            <li class="rounded-xl border border-border bg-surface px-4 py-3">
              <a href={tool.href} class="font-bold hover:text-accent">
                <LocaleText ko={tool.label} en={staticEnglish(tool.label)} />
              </a>
              <p class="mt-1 text-sm text-muted"><LocaleText ko={tool.summary} en={staticEnglish(tool.summary)} /></p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
