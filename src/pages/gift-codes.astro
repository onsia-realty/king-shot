---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import GiftCodeTable, { type GiftCode } from '@/components/islands/GiftCodeTable';
import GiftCodeCalendar from '@/components/islands/GiftCodeCalendar';
import { todayKST, statusOf } from '@/lib/gift-codes';
import giftCodes from '@/data/gift-codes.json';

interface GiftCodeFile {
  lastChecked: string;
  codes: GiftCode[];
}

const data = giftCodes as GiftCodeFile;

/**
 * 상태 판정은 전부 src/lib/gift-codes.ts 에 맡긴다.
 * 예전에는 이 파일이 빌드 시각 UTC 로 직접 만료를 갈랐는데, 동기화 스크립트는 KST 를
 * 써서 하루가 어긋날 수 있었다.
 */
const today = todayKST();
const active = data.codes.filter((c) => statusOf(c, today) === '활성');
const upcoming = data.codes.filter((c) => statusOf(c, today) === '예정');
const expired = data.codes.filter((c) => statusOf(c, today) === '만료');

/** 만료 코드는 82개 중 대부분이라 한 표에 쏟으면 못 읽는다. 월별로 접어 둔다. */
const monthKeyOf = (c: GiftCode) => (c.startsAt ?? c.expiresAt ?? c.addedAt).slice(0, 7);
const expiredByMonth = [...new Set(expired.map(monthKeyOf))]
  .sort()
  .reverse()
  .map((month) => ({
    month,
    label: `${Number(month.slice(0, 4))}년 ${Number(month.slice(5, 7))}월`,
    codes: expired
      .filter((c) => monthKeyOf(c) === month)
      .sort((a, b) => (b.startsAt ?? '').localeCompare(a.startsAt ?? '')),
  }));

const REDEEM_URL = 'https://ks-giftcode.centurygame.com';
/** 코드 출처. scripts/sync-gift-codes.mjs 가 매일 이 주소를 확인한다. */
const SOURCE_URL = 'https://kingshotwiki.com/ko/giftcode/';

const title = '킹샷 기프트 코드';
const description =
  '킹샷(Kingshot) 기프트 코드 목록과 교환 방법입니다. 확인된 코드만 올리고, 마지막 확인일을 함께 표기합니다.';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '킹샷 기프트 코드는 어디서 입력하나요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `공식 교환 페이지(${REDEEM_URL})에 게임 내 플레이어 ID와 코드를 입력하면 우편함으로 보상이 들어옵니다.`,
      },
    },
    {
      '@type': 'Question',
      name: '내 플레이어 ID는 어디서 확인하나요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '게임에서 좌측 상단 프로필(캐릭터 초상)을 눌러 프로필 창을 열면 이름 아래에 숫자로 된 ID가 보입니다.',
      },
    },
  ],
};

/**
 * 코드 목록을 ItemList 로도 내보낸다. 날짜가 없는 코드는 validFrom/validThrough 를
 * 아예 빼야 한다 — 빈 문자열을 넣으면 구조화 데이터 검사에서 오류가 난다.
 */
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '킹샷 기프트 코드 목록',
  numberOfItems: data.codes.length,
  itemListElement: data.codes.map((c, i) => {
    const status = statusOf(c, today);
    const offer: Record<string, unknown> = {
      '@type': 'Offer',
      sku: c.code,
      availability:
        status === '만료'
          ? 'https://schema.org/Discontinued'
          : status === '예정'
            ? 'https://schema.org/PreOrder'
            : 'https://schema.org/InStock',
      price: 0,
      priceCurrency: 'KRW',
    };
    if (c.startsAt) offer.validFrom = c.startsAt;
    if (c.expiresAt) offer.validThrough = c.expiresAt;

    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: `킹샷 기프트 코드 ${c.code}`,
        sku: c.code,
        offers: offer,
      },
    };
  }),
};
---

<BaseLayout title={title} description={description} jsonLd={[faqLd, itemListLd]}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb items={[{ label: '홈', href: '/' }, { label: '기프트코드' }]} class="mb-6" />

    <header class="mb-6">
      <h1 class="text-3xl font-extrabold sm:text-4xl">기프트 코드</h1>
      <p class="mt-3 max-w-2xl text-muted">
        확인된 코드만 올립니다. 커뮤니티에 도는 코드를 그대로 옮겨 적는 대신, 실제로 교환이 되는지
        확인한 것만 여기에 남깁니다.
      </p>
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        <span>
          마지막 확인일 <strong class="text-text tabular-nums">{data.lastChecked}</strong>
        </span>
        <span
          class="rounded-full border border-success/50 px-2.5 py-0.5 text-xs font-bold text-success tabular-nums"
        >
          활성 {active.length}
        </span>
      </p>
    </header>

    <section class="mt-10">
      <h2 class="text-xl font-bold">사용 가능한 코드</h2>
      <div class="mt-3">
        <GiftCodeTable
          client:load
          codes={active}
          emptyMessage="현재 확인된 코드가 없습니다. 새 코드가 풀리면 이 자리에 올라옵니다."
        />
      </div>
      <p class="mt-3 text-sm text-muted">
        출처: Century Games <a href={SOURCE_URL} target="_blank" rel="noopener noreferrer">공식 위키</a>.
        하루 한 번 자동으로 확인해 새 코드를 반영합니다.
      </p>
    </section>

    {
      upcoming.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold">곧 시작하는 코드</h2>
          <p class="mt-2 text-sm text-muted">
            아직 시작 전이라 지금 넣으면 오류가 납니다. 시작일을 확인하세요.
          </p>
          <div class="mt-3">
            <GiftCodeTable
              client:load
              codes={upcoming}
              emptyMessage="예정된 코드가 없습니다."
            />
          </div>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold">월별 캘린더</h2>
      <p class="mt-2 text-sm text-muted">
        코드는 유효 시작일 칸에 놓입니다. 날짜를 누르면 그 날 풀린 코드를 아래에서 볼 수 있습니다.
      </p>
      <div class="mt-3">
        <GiftCodeCalendar client:load codes={data.codes} today={today} />
      </div>
    </section>

    {
      expiredByMonth.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold">만료된 코드</h2>
          <p class="mt-2 text-sm text-muted">
            이미 기간이 지난 코드입니다. 기록 삼아 월별로 접어 남겨 둡니다.
          </p>
          <div class="mt-3 space-y-2">
            {expiredByMonth.map((group, i) => (
              <details
                class="overflow-hidden rounded-xl border border-border bg-surface"
                open={i === 0}
              >
                <summary class="cursor-pointer list-none px-4 py-3 text-sm font-bold hover:bg-raised">
                  <span class="tabular-nums">{group.label}</span>
                  <span class="ml-2 font-normal text-muted">{group.codes.length}개</span>
                </summary>
                <div class="overflow-x-auto border-t border-border">
                  <table class="w-full border-collapse text-sm">
                    <thead>
                      <tr class="bg-raised text-left">
                        <th class="px-4 py-2.5 font-bold whitespace-nowrap">코드</th>
                        <th class="px-4 py-2.5 font-bold">보상</th>
                        <th class="px-4 py-2.5 font-bold whitespace-nowrap">유효 기간</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.codes.map((c) => (
                        <tr class="border-t border-border align-top">
                          <td class="px-4 py-2.5">
                            <code class="rounded-md border border-border px-2 py-1 font-mono text-sm font-bold text-muted line-through">
                              {c.code}
                            </code>
                            {c.note && <p class="mt-1 text-xs text-muted">{c.note}</p>}
                          </td>
                          <td class="px-4 py-2.5 text-muted">{c.rewards.trim() || '보상 미확인'}</td>
                          <td class="px-4 py-2.5 text-muted tabular-nums">
                            {c.startsAt ? `${c.startsAt} ~ ` : ''}
                            {c.expiresAt ?? '-'}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="text-xl font-bold">교환하는 방법</h2>
      <ol class="mt-4 space-y-3">
        <li class="flex gap-3 rounded-xl border border-border bg-surface px-4 py-3">
          <span
            class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-extrabold text-on-accent"
            aria-hidden="true">1</span
          >
          <span class="text-sm leading-relaxed">
            게임에서 좌측 상단 초상을 눌러 프로필을 열고, 이름 아래 <strong>플레이어 ID</strong>를
            확인합니다.
          </span>
        </li>
        <li class="flex gap-3 rounded-xl border border-border bg-surface px-4 py-3">
          <span
            class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-extrabold text-on-accent"
            aria-hidden="true">2</span
          >
          <span class="text-sm leading-relaxed">
            <a href={REDEEM_URL} target="_blank" rel="noopener noreferrer">공식 교환 페이지</a>에
            들어가 플레이어 ID로 로그인합니다.
          </span>
        </li>
        <li class="flex gap-3 rounded-xl border border-border bg-surface px-4 py-3">
          <span
            class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-extrabold text-on-accent"
            aria-hidden="true">3</span
          >
          <span class="text-sm leading-relaxed">
            코드를 붙여넣고 교환을 누르면 게임 <strong>우편함</strong>으로 보상이 들어옵니다.
          </span>
        </li>
      </ol>

      <p class="mt-4">
        <a
          href={REDEEM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 font-bold text-on-accent no-underline hover:bg-accent-strong hover:text-on-accent"
        >
          공식 교환 페이지 열기
          <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="text-xl font-bold">코드가 안 먹힐 때</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
        <li>· 이미 사용한 코드는 계정당 한 번만 됩니다. 다른 계정으로 다시 쓸 수는 있습니다.</li>
        <li>· 대소문자를 그대로 옮겨야 합니다. 복사 버튼을 쓰면 실수가 없습니다.</li>
        <li>· 기간이 지난 코드는 오류 메시지가 뜹니다. 아래 만료 목록을 확인하세요.</li>
        <li>· 신규 계정은 일정 레벨 이상이어야 교환이 열리는 코드도 있습니다.</li>
      </ul>
    </section>

    <div class="mt-10 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
