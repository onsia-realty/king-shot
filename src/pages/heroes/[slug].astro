---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RarityBadge from '@/components/RarityBadge.astro';
import ClassIcon from '@/components/ClassIcon.astro';
import TierBadge from '@/components/TierBadge.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import { rarityLabel } from '@/lib/labels';

export async function getStaticPaths() {
  const heroes = await getCollection('heroes');
  return heroes.map((hero) => ({ params: { slug: hero.id }, props: { hero } }));
}

const { hero } = Astro.props as { hero: CollectionEntry<'heroes'> };
const d = hero.data;
const { Content } = await render(hero);

const all = (await getCollection('heroes')).sort((a, b) => a.data.order - b.data.order);

/** 같은 세대를 먼저 채우고, 모자라면 같은 병종에서 보충한다 */
const sameGen = all.filter((h) => h.id !== hero.id && h.data.generation === d.generation);
const sameClass = all.filter(
  (h) => h.id !== hero.id && h.data.troopClass === d.troopClass && !sameGen.includes(h),
);
const related = [...sameGen, ...sameClass].slice(0, 4);

const RATING_LABELS: Record<string, string> = {
  bearRally: '곰사냥 집결',
  garrison: '수성 방어',
  arena: '아레나',
  f2p: '무과금 가치',
};

const ratingRows = (['bearRally', 'garrison', 'arena', 'f2p'] as const)
  .map((key) => ({ key, label: RATING_LABELS[key], tier: d.ratings?.[key] }))
  .filter((row): row is { key: typeof row.key; label: string; tier: NonNullable<typeof row.tier> } =>
    Boolean(row.tier),
  );

const hasStats = Boolean(d.stats);
const hasSkills = d.skills.length > 0;

const rarityVar = `var(--ks-rarity-${d.rarity.toLowerCase()})`;
const placeholderStyle = `background-image: linear-gradient(150deg, color-mix(in oklab, ${rarityVar} 45%, transparent), color-mix(in oklab, ${rarityVar} 8%, transparent) 65%, transparent); color: ${rarityVar};`;

const RARITY_RING = {
  SSR: 'ring-rarity-ssr',
  SR: 'ring-rarity-sr',
  R: 'ring-rarity-r',
  N: 'ring-rarity-n',
} as const;

const title = `${d.name} (${d.nameEn})`;
const description = `킹샷 ${d.name}(${d.nameEn}) — ${d.generation}세대 ${rarityLabel(d.rarity)} ${d.troopClass}. ${d.summary}`;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[{ label: '홈', href: '/' }, { label: '영웅', href: '/heroes/' }, { label: d.name }]}
      class="mb-6"
    />

    <header class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <div
        class:list={[
          'flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-xl text-4xl font-extrabold',
          d.portrait
            ? ['bg-raised ring-2 ring-inset', RARITY_RING[d.rarity]]
            : 'border border-border',
        ]}
        style={d.portrait ? undefined : placeholderStyle}
        aria-hidden={d.portrait ? undefined : 'true'}
      >
        {d.portrait ? (
          <Image
            src={d.portrait}
            alt={`${d.name} (${d.nameEn}) 초상`}
            width={256}
            height={256}
            loading="eager"
            decoding="async"
            class="size-24 object-cover"
          />
        ) : (
          d.name.trim().slice(0, 1)
        )}
      </div>

      <div>
        <h1 class="text-3xl font-extrabold sm:text-4xl">
          {d.name} <span class="text-muted">({d.nameEn})</span>
        </h1>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <RarityBadge rarity={d.rarity} />
          <ClassIcon troopClass={d.troopClass} />
          <span class="inline-flex items-center rounded-md border border-border bg-raised px-2 py-0.5 text-xs font-bold text-muted">
            {d.generation}세대
          </span>
          <span class="inline-flex items-center rounded-md border border-border px-2 py-0.5 text-xs text-muted">
            획득: {d.acquisition}
          </span>
        </div>
      </div>
    </header>

    <p class="mt-5 rounded-xl border border-border bg-surface px-4 py-3 text-muted">{d.summary}</p>

    {ratingRows.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">용도별 평가</h2>
        <div class="table-wrap mt-3">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-raised text-left">
                <th class="px-4 py-3 font-bold whitespace-nowrap">용도</th>
                <th class="px-4 py-3 font-bold whitespace-nowrap">티어</th>
              </tr>
            </thead>
            <tbody>
              {ratingRows.map((row) => (
                <tr class="border-t border-border">
                  <td class="px-4 py-3">{row.label}</td>
                  <td class="px-4 py-3"><TierBadge tier={row.tier} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {hasStats && d.stats && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">기본 능력치</h2>
        <div class="table-wrap mt-3">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-raised text-left">
                <th class="px-4 py-3 font-bold">공격</th>
                <th class="px-4 py-3 font-bold">방어</th>
                <th class="px-4 py-3 font-bold">체력</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-border tabular-nums">
                <td class="px-4 py-3">{d.stats.attack.toLocaleString('ko-KR')}</td>
                <td class="px-4 py-3">{d.stats.defense.toLocaleString('ko-KR')}</td>
                <td class="px-4 py-3">{d.stats.hp.toLocaleString('ko-KR')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )}

    {hasSkills && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">스킬</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          {d.skills.map((skill) => (
            <li class="rounded-xl border border-border bg-surface p-4">
              <div class="flex items-center gap-2">
                <h3 class="font-bold">{skill.name}</h3>
                <span class="inline-flex items-center rounded-md border border-accent/40 bg-accent/12 px-1.5 py-0.5 text-[11px] font-bold text-accent">
                  {skill.type}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted">{skill.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {(!hasStats || !hasSkills) && (
      <p class="mt-8 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
        {d.name}의 {!hasStats && !hasSkills ? '능력치와 스킬' : !hasStats ? '능력치' : '스킬'} 수치는
        아직 비워 뒀습니다. 추측으로 채우지 않고, 정확한 수치는 게임 내 확인 후 채웁니다.
      </p>
    )}

    {d.exclusiveGear && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">전용 장비</h2>
        <p class="mt-3 rounded-xl border border-border bg-surface px-4 py-3 text-muted">
          {d.exclusiveGear}
        </p>
      </section>
    )}

    <div class="prose mt-10">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="mt-12 border-t border-border pt-8">
        <h2 class="text-xl font-bold">함께 보면 좋은 영웅</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {related.map((h) => (
            <li>
              <a
                href={`/heroes/${h.id}/`}
                class="flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-3 no-underline transition-colors hover:border-accent/50 hover:bg-raised"
              >
                <span class="font-bold text-text">{h.data.name}</span>
                <span class="text-xs text-muted">{h.data.nameEn}</span>
                <span class="ml-auto flex shrink-0 items-center gap-1.5">
                  <RarityBadge rarity={h.data.rarity} size="sm" />
                  <ClassIcon troopClass={h.data.troopClass} size="sm" iconOnly />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-10 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
