---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RarityBadge from '@/components/RarityBadge.astro';
import ClassIcon from '@/components/ClassIcon.astro';
import TierBadge from '@/components/TierBadge.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import SkillCard from '@/components/SkillCard.astro';
import { rarityLabel } from '@/lib/labels';
import { HERO_SHARD_ROWS, HERO_SHARD_STARS, HERO_SHARD_TOTALS } from '@/data/hero-shard';

export async function getStaticPaths() {
  const heroes = await getCollection('heroes');
  return heroes.map((hero) => ({ params: { slug: hero.id }, props: { hero } }));
}

const { hero } = Astro.props as { hero: CollectionEntry<'heroes'> };
const d = hero.data;
const { Content } = await render(hero);

const all = (await getCollection('heroes')).sort((a, b) => a.data.order - b.data.order);

/** 같은 세대를 먼저 채우고, 모자라면 같은 병종에서 보충한다 */
const sameGen = all.filter((h) => h.id !== hero.id && h.data.generation === d.generation);
const sameClass = all.filter(
  (h) => h.id !== hero.id && h.data.troopClass === d.troopClass && !sameGen.includes(h),
);
const related = [...sameGen, ...sameClass].slice(0, 4);

const RATING_LABELS: Record<string, string> = {
  bearRally: '곰사냥 집결',
  garrison: '수성 방어',
  arena: '아레나',
  f2p: '무과금 가치',
};

const ratingRows = (['bearRally', 'garrison', 'arena', 'f2p'] as const)
  .map((key) => ({ key, label: RATING_LABELS[key], tier: d.ratings?.[key] }))
  .filter((row): row is { key: typeof row.key; label: string; tier: NonNullable<typeof row.tier> } =>
    Boolean(row.tier),
  );

/** 전투력은 토벌(절대수치)과 원정(퍼센트) 둘로 나뉘고, 한 쪽만 있어도 그 쪽만 렌더한다 */
const exploration = d.stats?.exploration;
const expedition = d.stats?.expedition;
const hasStats = Boolean(exploration || expedition);

/** 스킬은 mode 로 토벌/원정/특성을 갈라 나란히 보여준다 (탭을 쓰면 JS 아일랜드가 필요해진다) */
const explorationSkills = d.skills.filter((s) => s.mode === '토벌');
const expeditionSkills = d.skills.filter((s) => s.mode === '원정');
const talentSkills = d.skills.filter((s) => s.mode === '특성');
const hasSkills = d.skills.length > 0;

const gear = d.exclusiveGear;
const hasGear = Boolean(gear);

/** 아직 못 채운 항목만 골라 안내 문구를 만든다 */
const missingParts = [
  !hasStats && '전투력',
  !hasSkills && '스킬',
  !hasGear && '전용 장비',
].filter((part): part is string => typeof part === 'string');

const rarityVar = `var(--ks-rarity-${d.rarity.toLowerCase()})`;
const placeholderStyle = `background-image: linear-gradient(150deg, color-mix(in oklab, ${rarityVar} 45%, transparent), color-mix(in oklab, ${rarityVar} 8%, transparent) 65%, transparent); color: ${rarityVar};`;

const RARITY_RING = {
  SSR: 'ring-rarity-ssr',
  SR: 'ring-rarity-sr',
  R: 'ring-rarity-r',
  N: 'ring-rarity-n',
} as const;

const title = `${d.name} (${d.nameEn})`;
const description = [
  `킹샷 ${d.name}(${d.nameEn}) — ${d.generation}세대 ${rarityLabel(d.rarity)} ${d.troopClass}.`,
  d.summary,
  gear ? `전용 장비 ${gear.name}.` : '',
].filter(Boolean).join(' ');
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[{ label: '홈', href: '/' }, { label: '영웅', href: '/heroes/' }, { label: d.name }]}
      class="mb-6"
    />

    <header class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <div
        class:list={[
          'flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-xl text-4xl font-extrabold',
          d.portrait
            ? ['bg-raised ring-2 ring-inset', RARITY_RING[d.rarity]]
            : 'border border-border',
        ]}
        style={d.portrait ? undefined : placeholderStyle}
        aria-hidden={d.portrait ? undefined : 'true'}
      >
        {d.portrait ? (
          <Image
            src={d.portrait}
            alt={`${d.name} (${d.nameEn}) 초상`}
            width={256}
            height={256}
            loading="eager"
            decoding="async"
            class="size-24 object-cover"
          />
        ) : (
          d.name.trim().slice(0, 1)
        )}
      </div>

      <div>
        <h1 class="text-3xl font-extrabold sm:text-4xl">
          {d.name} <span class="text-muted">({d.nameEn})</span>
        </h1>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <RarityBadge rarity={d.rarity} />
          <ClassIcon troopClass={d.troopClass} />
          <span class="inline-flex items-center rounded-md border border-border bg-raised px-2 py-0.5 text-xs font-bold text-muted">
            {d.generation}세대
          </span>
          {d.heroClass && (
            <span class="inline-flex items-center rounded-md border border-border bg-raised px-2 py-0.5 text-xs font-bold text-muted">
              {d.heroClass}형
            </span>
          )}
          <span class="inline-flex items-center rounded-md border border-border px-2 py-0.5 text-xs text-muted">
            획득: {d.acquisition}
          </span>
        </div>
      </div>
    </header>

    <p class="mt-5 rounded-xl border border-border bg-surface px-4 py-3 text-muted">{d.summary}</p>

    {ratingRows.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">용도별 평가</h2>
        <div class="table-wrap mt-3">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-raised text-left">
                <th class="px-4 py-3 font-bold whitespace-nowrap">용도</th>
                <th class="px-4 py-3 font-bold whitespace-nowrap">티어</th>
              </tr>
            </thead>
            <tbody>
              {ratingRows.map((row) => (
                <tr class="border-t border-border">
                  <td class="px-4 py-3">{row.label}</td>
                  <td class="px-4 py-3"><TierBadge tier={row.tier} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {hasStats && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">전투력</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {exploration && (
            <div class="rounded-xl border border-border bg-surface p-4">
              <h3 class="text-sm font-bold text-accent">토벌</h3>
              <dl class="mt-2 grid grid-cols-3 gap-2 text-sm tabular-nums">
                <div>
                  <dt class="text-xs text-muted">공격력</dt>
                  <dd class="font-bold">{exploration.attack.toLocaleString('ko-KR')}</dd>
                </div>
                <div>
                  <dt class="text-xs text-muted">방어력</dt>
                  <dd class="font-bold">{exploration.defense.toLocaleString('ko-KR')}</dd>
                </div>
                <div>
                  <dt class="text-xs text-muted">HP</dt>
                  <dd class="font-bold">{exploration.hp.toLocaleString('ko-KR')}</dd>
                </div>
              </dl>
            </div>
          )}
          {expedition && (
            <div class="rounded-xl border border-border bg-surface p-4">
              <h3 class="text-sm font-bold text-accent">원정</h3>
              <dl class="mt-2 grid grid-cols-3 gap-2 text-sm tabular-nums">
                <div>
                  <dt class="text-xs text-muted">공격력</dt>
                  <dd class="font-bold">{expedition.attack}</dd>
                </div>
                <div>
                  <dt class="text-xs text-muted">방어력</dt>
                  <dd class="font-bold">{expedition.defense}</dd>
                </div>
              </dl>
            </div>
          )}
        </div>
      </section>
    )}

    {hasSkills && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">스킬</h2>
        {explorationSkills.length > 0 && (
          <>
            <h3 class="mt-4 text-sm font-bold text-accent">토벌 스킬</h3>
            <ul class="mt-2 grid gap-3 sm:grid-cols-2">
              {explorationSkills.map((skill) => <SkillCard skill={skill} />)}
            </ul>
          </>
        )}
        {expeditionSkills.length > 0 && (
          <>
            <h3 class="mt-5 text-sm font-bold text-accent">원정 스킬</h3>
            <ul class="mt-2 grid gap-3 sm:grid-cols-2">
              {expeditionSkills.map((skill) => <SkillCard skill={skill} />)}
            </ul>
          </>
        )}
        {talentSkills.length > 0 && (
          <>
            <h3 class="mt-5 text-sm font-bold text-accent">특성 스킬</h3>
            <ul class="mt-2 grid gap-3 sm:grid-cols-2">
              {talentSkills.map((skill) => <SkillCard skill={skill} />)}
            </ul>
          </>
        )}
      </section>
    )}

    {gear && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">전용 장비</h2>
        <div class="mt-3 rounded-xl border border-border bg-surface p-4">
          <div class="flex items-center gap-3">
            {gear.icon && (
              <Image
                src={gear.icon}
                alt={gear.name}
                width={160}
                height={160}
                loading="lazy"
                decoding="async"
                class="size-20 shrink-0 rounded-xl border border-border bg-raised object-contain"
              />
            )}
            <div class="flex min-w-0 flex-wrap items-baseline gap-x-2">
              <h3 class="font-bold">{gear.name}</h3>
              <span class="text-xs text-muted">{gear.nameEn}</span>
            </div>
          </div>

          {(gear.exploration || gear.expedition) && (
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {gear.exploration && (
                <div class="rounded-lg border border-border bg-raised p-3">
                  <h4 class="text-xs font-bold text-accent">토벌</h4>
                  <dl class="mt-1.5 grid grid-cols-3 gap-2 text-sm tabular-nums">
                    <div>
                      <dt class="text-xs text-muted">공격력</dt>
                      <dd class="font-bold">{gear.exploration.attack.toLocaleString('ko-KR')}</dd>
                    </div>
                    <div>
                      <dt class="text-xs text-muted">방어력</dt>
                      <dd class="font-bold">{gear.exploration.defense.toLocaleString('ko-KR')}</dd>
                    </div>
                    <div>
                      <dt class="text-xs text-muted">HP</dt>
                      <dd class="font-bold">{gear.exploration.hp.toLocaleString('ko-KR')}</dd>
                    </div>
                  </dl>
                </div>
              )}
              {gear.expedition && (
                <div class="rounded-lg border border-border bg-raised p-3">
                  <h4 class="text-xs font-bold text-accent">원정</h4>
                  <dl class="mt-1.5 grid grid-cols-3 gap-2 text-sm tabular-nums">
                    <div>
                      <dt class="text-xs text-muted">파괴력</dt>
                      <dd class="font-bold">{gear.expedition.lethality}</dd>
                    </div>
                    <div>
                      <dt class="text-xs text-muted">HP</dt>
                      <dd class="font-bold">{gear.expedition.hp}</dd>
                    </div>
                  </dl>
                </div>
              )}
            </div>
          )}

          {gear.parts.length > 0 && (
            <>
              <h4 class="mt-5 text-sm font-bold">부속품 업그레이드</h4>
              <div class="table-wrap mt-2">
                <table class="w-full border-collapse text-sm">
                  <thead>
                    <tr class="bg-raised text-left">
                      <th class="px-3 py-2 font-bold whitespace-nowrap">레벨</th>
                      {gear.parts.map((_, i) => (
                        <th class="px-3 py-2 text-right font-bold tabular-nums">{i + 1}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-t border-border tabular-nums">
                      <td class="px-3 py-2 whitespace-nowrap">부속품</td>
                      {gear.parts.map((count) => (
                        <td class="px-3 py-2 text-right">{count.toLocaleString('ko-KR')}</td>
                      ))}
                    </tr>
                  </tbody>
                </table>
              </div>
            </>
          )}

          {gear.skills.length > 0 && (
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {gear.skills.map((skill) => <SkillCard skill={skill} showMode />)}
            </ul>
          )}
        </div>
      </section>
    )}

    {missingParts.length > 0 && (
      <p class="mt-8 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
        {d.name}의 {missingParts.join('·')} 정보는 아직 비워 뒀습니다. 추측으로 채우지 않고,
        정확한 수치는 게임 내 확인 후 채웁니다.
      </p>
    )}

    <section class="mt-10">
      <h2 class="text-xl font-bold">영웅 파편 업그레이드</h2>
      <p class="mt-2 text-sm text-muted">
        영웅별로 다르지 않고 모든 영웅에 똑같이 적용되는 표다. 1성부터 5성까지 올리려면 파편이 모두
        {' '}{HERO_SHARD_TOTALS.reduce((sum, n) => sum + n, 0).toLocaleString('ko-KR')}개 든다.
      </p>
      <div class="table-wrap mt-3">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-raised text-left">
              <th class="px-3 py-2 font-bold whitespace-nowrap">등급</th>
              {HERO_SHARD_STARS.map((star) => (
                <th class="px-3 py-2 text-right font-bold whitespace-nowrap">{star}성</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {HERO_SHARD_ROWS.map((row) => (
              <tr class="border-t border-border tabular-nums">
                <td class="px-3 py-2 font-bold whitespace-nowrap">{row.tier}</td>
                {row.counts.map((count) => (
                  <td class="px-3 py-2 text-right">{count.toLocaleString('ko-KR')}</td>
                ))}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-border bg-raised tabular-nums">
              <td class="px-3 py-2 font-bold whitespace-nowrap">합계</td>
              {HERO_SHARD_TOTALS.map((total) => (
                <td class="px-3 py-2 text-right font-bold">{total.toLocaleString('ko-KR')}</td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

    <div class="prose mt-10">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="mt-12 border-t border-border pt-8">
        <h2 class="text-xl font-bold">함께 보면 좋은 영웅</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {related.map((h) => (
            <li>
              <a
                href={`/heroes/${h.id}/`}
                class="flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-3 no-underline transition-colors hover:border-accent/50 hover:bg-raised"
              >
                <span class="font-bold text-text">{h.data.name}</span>
                <span class="text-xs text-muted">{h.data.nameEn}</span>
                <span class="ml-auto flex shrink-0 items-center gap-1.5">
                  <RarityBadge rarity={h.data.rarity} size="sm" />
                  <ClassIcon troopClass={h.data.troopClass} size="sm" iconOnly />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-10 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
