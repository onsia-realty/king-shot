---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';

export async function getStaticPaths() {
  const buildings = await getCollection('buildings');
  return buildings.map((building) => ({ params: { slug: building.id }, props: { building } }));
}

interface Props {
  building: CollectionEntry<'buildings'>;
}

const { building } = Astro.props;
const d = building.data;
const { Content } = await render(building);

const all = (await getCollection('buildings')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((b) => b.id !== building.id).slice(0, 6);

const title = `${d.name} (${d.nameEn})`;
const description = `킹샷 ${d.name}(${d.nameEn}) — ${d.summary}`;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb
      items={[{ label: '홈', href: '/' }, { label: '건물', href: '/buildings/' }, { label: d.name }]}
      class="mb-6"
    />

    <header class="flex items-center gap-4">
      {d.icon && (
        <Image
          src={d.icon}
          alt={`${d.name} (${d.nameEn}) 아이콘`}
          width={256}
          height={256}
          loading="eager"
          decoding="async"
          class="size-20 shrink-0 rounded-xl border border-border bg-raised object-cover"
        />
      )}
      <h1 class="text-3xl font-extrabold sm:text-4xl">
        {d.name} <span class="text-muted">({d.nameEn})</span>
      </h1>
    </header>

    <p class="mt-5 rounded-xl border border-border bg-surface px-4 py-3 text-muted">{d.summary}</p>

    {(d.unlock || d.maxLevel !== undefined) && (
      <div class="mt-6 flex flex-wrap gap-2">
        {d.unlock && (
          <span class="rounded-lg border border-border bg-surface px-3 py-1.5 text-sm text-muted">
            해금 조건 <strong class="text-text">{d.unlock}</strong>
          </span>
        )}
        {d.maxLevel !== undefined && (
          <span class="rounded-lg border border-border bg-surface px-3 py-1.5 text-sm text-muted">
            최대 레벨 <strong class="text-text">{d.maxLevel}</strong>
          </span>
        )}
      </div>
    )}

    {d.effects.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">주요 효과</h2>
        <ul class="mt-3 space-y-2">
          {d.effects.map((effect) => (
            <li class="flex gap-2.5 rounded-lg border border-border bg-surface px-4 py-2.5 text-sm leading-relaxed">
              <span aria-hidden="true" class="text-accent">•</span>
              <span>{effect}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="prose mt-10">
      <Content />
    </div>

    {building.id !== 'town-center' && (
      <p class="mt-8 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
        이 건물이 더 올라가지 않는다면
        <a href="/buildings/town-center/" class="font-bold">도시 센터</a> 레벨을 먼저 확인하세요.
        도시 센터가 모든 건물의 상한선입니다.
      </p>
    )}

    {others.length > 0 && (
      <section class="mt-12 border-t border-border pt-8">
        <h2 class="text-xl font-bold">다른 건물</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {others.map((b) => (
            <li>
              <a
                href={`/buildings/${b.id}/`}
                class="flex items-baseline gap-2 rounded-xl border border-border bg-surface px-4 py-3 no-underline transition-colors hover:border-accent/50 hover:bg-raised"
              >
                <span class="font-bold text-text">{b.data.name}</span>
                <span class="text-xs text-muted">{b.data.nameEn}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-10 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
