---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Disclaimer from '@/components/Disclaimer.astro';

const buildings = (await getCollection('buildings')).sort((a, b) => a.data.order - b.data.order);

const site = Astro.site ?? new URL('https://example.com');

const title = '킹샷 건물 정리';
const description = `킹샷 건물 ${buildings.length}종의 역할과 올리는 순서를 정리했습니다. 도시 센터가 나머지 건물의 상한을 정하는 구조부터 확인하세요.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  numberOfItems: buildings.length,
  itemListElement: buildings.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${b.data.name} (${b.data.nameEn})`,
    url: new URL(`/buildings/${b.id}/`, site).href,
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb items={[{ label: '홈', href: '/' }, { label: '건물' }]} class="mb-6" />

    <header class="mb-6">
      <h1 class="text-3xl font-extrabold sm:text-4xl">건물</h1>
      <p class="mt-3 max-w-2xl text-muted">
        도시를 굴리는 건물 {buildings.length}종입니다. 각 건물이 무엇을 담당하고 언제 올리는 게
        이득인지 정리했습니다.
      </p>
    </header>

    <p
      class="mb-8 rounded-xl border border-accent/40 bg-accent/10 px-4 py-3 text-sm leading-relaxed"
    >
      <strong class="text-accent">먼저 알아둘 것 —</strong>
      <a href="/buildings/town-center/" class="font-bold">도시 센터</a> 레벨이 나머지 건물의 최대
      레벨을 정합니다. 다른 건물이 더 안 올라간다면 십중팔구 도시 센터가 막고 있습니다.
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        buildings.map((b) => (
          <article class="group relative flex flex-col gap-2 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/50 hover:bg-raised">
            <div class="flex items-center gap-2.5">
              {b.data.icon && (
                <Image
                  src={b.data.icon}
                  alt={`${b.data.name} (${b.data.nameEn}) 아이콘`}
                  width={128}
                  height={128}
                  loading="lazy"
                  decoding="async"
                  class="size-12 shrink-0 rounded-lg border border-border bg-raised object-cover"
                />
              )}
              <h2 class="text-base font-bold leading-tight">
                <a
                  href={`/buildings/${b.id}/`}
                  class="text-text no-underline after:absolute after:inset-0 hover:text-accent"
                >
                  {b.data.name}
                </a>
                <span class="ml-1.5 text-xs font-normal text-muted">{b.data.nameEn}</span>
              </h2>
            </div>
            <p class="text-sm leading-relaxed text-muted">{b.data.summary}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-12 border-t border-border pt-6">
      <Disclaimer />
    </div>
  </div>
</BaseLayout>
