---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import VisitCounter from '@/components/VisitCounter.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import GuideCard from '@/components/GuideCard.astro';
import {
  CATEGORIES,
  CATEGORY_DESCRIPTIONS,
  CATEGORY_EMOJI,
  categoryHref,
  sortByPublished,
} from '@/lib/guides';
import KakaoButton from '@/components/KakaoButton.astro';
import { SITE_NAME, SITE_DESCRIPTION, KAKAO_OPENCHAT } from '@/data/nav';

const guides = sortByPublished(await getCollection('guides', ({ data }) => !data.draft));
const featured = guides.filter((g) => g.data.featured).slice(0, 3);
const latest = guides.slice(0, 6);

const counts = new Map<string, number>();
for (const g of guides) counts.set(g.data.category, (counts.get(g.data.category) ?? 0) + 1);

const site = Astro.site ?? new URL('https://example.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: '킹샷 한국어 공략',
  url: site.href,
  inLanguage: 'ko-KR',
  description: SITE_DESCRIPTION,
};

const entryButtons = [
  { label: '공략 보기', href: '/guides/', primary: true },
  { label: '영웅 도감', href: '/heroes/' },
  { label: '건물 정보', href: '/buildings/' },
  { label: '기프트 코드', href: '/gift-codes/' },
];

const database = [
  {
    label: '영웅',
    href: '/heroes/',
    emoji: '🦸',
    desc: '등급·병종·스킬과 티어 평가를 한 표로.',
  },
  {
    label: '건물',
    href: '/buildings/',
    emoji: '🏰',
    desc: '해금 조건과 효과, 올리는 순서까지.',
  },
  { label: '펫', href: '/pets/', emoji: '🐾', desc: '펫 등급과 스킬, 우선순위 정리.' },
  {
    label: '기프트 코드',
    href: '/gift-codes/',
    emoji: '🎁',
    desc: '지금 쓸 수 있는 코드와 입력 방법.',
  },
];
---

<BaseLayout fullTitle="킹샷 공략 — 영주 장비·왕국 지도·순금 계산기" description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  {/* 1. 히어로 */}
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-12 sm:pt-20">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-10">
    <div class="min-w-0">
    <p class="mb-3 text-sm font-bold tracking-widest text-accent uppercase">Kingshot</p>
    <h1 class="text-4xl leading-tight font-extrabold sm:text-5xl">
      킹샷 공략, <span class="text-accent">한국어로 한 곳에서</span>
    </h1>
    <p class="mt-5 max-w-2xl text-base text-muted sm:text-lg">
      {SITE_DESCRIPTION}
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        entryButtons.map((btn) =>
          btn.primary ? (
            <a
              href={btn.href}
              class="rounded-lg bg-accent px-5 py-2.5 font-bold text-on-accent no-underline hover:bg-accent-strong hover:text-on-accent"
            >
              {btn.label}
            </a>
          ) : (
            <a
              href={btn.href}
              class="rounded-lg border border-border bg-surface px-5 py-2.5 font-bold text-text no-underline hover:bg-raised hover:text-accent"
            >
              {btn.label}
            </a>
          )
        )
      }
    </div>

    <VisitCounter />
    </div>
    <a
      href={KAKAO_OPENCHAT.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="킹샷 카카오톡 오픈채팅 참여하기 (새 창 열림)"
      class="group flex flex-col rounded-2xl bg-kakao p-7 text-kakao-ink no-underline transition-shadow hover:text-kakao-ink hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-kakao lg:min-h-72"
    >
      <div class="flex items-center gap-2 text-sm font-bold">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 3C6.477 3 2 6.477 2 10.8c0 2.77 1.86 5.2 4.66 6.57-.2.72-.74 2.68-.85 3.1-.13.52.19.51.4.37.17-.11 2.6-1.77 3.65-2.49.69.1 1.4.15 2.14.15 5.523 0 10-3.477 10-7.7S17.523 3 12 3Z" />
        </svg>
        카카오톡 오픈채팅
      </div>
      <h2 class="mt-5 text-2xl leading-snug font-extrabold">킹샷, 함께하면<br />더 쉬워집니다</h2>
      <p class="mt-3 text-sm leading-relaxed">{KAKAO_OPENCHAT.blurb}<br />궁금한 건 묻고, 공략은 함께 나눠요.</p>
      <span class="mt-6 flex items-center justify-between rounded-lg bg-kakao-ink px-4 py-3 text-sm font-bold text-kakao">
        오픈채팅 참여하기 <span aria-hidden="true">↗</span>
      </span>
    </a>
    </div>

    {/* 인트로 영상 */}
    <figure class="mt-10" data-intro>
      <div
        class="relative aspect-video w-full overflow-hidden rounded-xl border border-border bg-surface"
      >
        <video
          class="absolute inset-0 h-full w-full object-cover"
          poster="/video/intro-1622-poster.jpg"
          preload="metadata"
          muted
          loop
          playsinline
          autoplay
          tabindex="-1"
          aria-label="1622 서버 홍보 영상"
        >
          <source src="/video/intro-1622.webm" type="video/webm" />
          <source src="/video/intro-1622.mp4" type="video/mp4" />
        </video>

        {/* 가독성용 그라디언트 — 버튼이 밝은 장면 위에 와도 보이게 */}
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/70 to-transparent"
        >
        </div>

        <div class="absolute right-3 bottom-3 flex gap-2">
          <button
            type="button"
            data-intro-play
            aria-label="영상 일시정지"
            class="rounded-lg border border-border bg-surface/85 p-2 text-text backdrop-blur transition-colors hover:bg-raised hover:text-accent"
          >
            <span data-icon="play" hidden>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
            <span data-icon="pause">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6 5h4v14H6zm8 0h4v14h-4z"></path>
              </svg>
            </span>
          </button>

          <button
            type="button"
            data-intro-mute
            aria-label="소리 켜기"
            class="rounded-lg border border-border bg-surface/85 p-2 text-text backdrop-blur transition-colors hover:bg-raised hover:text-accent"
          >
            <span data-icon="muted">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3l3 3-1.4 1.4-3-3-3 3L10.7 15l3-3-3-3 1.4-1.4 3 3 3-3L19.5 9l-3 3z"
                ></path>
              </svg>
            </span>
            <span data-icon="sound" hidden>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4 9v6h4l5 4V5L8 9H4zm12-1.3A5.5 5.5 0 0 1 16 16.3v-1.8a3.8 3.8 0 0 0 0-6.6V7.7zm0-3.4a8.9 8.9 0 0 1 0 15.4v-1.8a7.1 7.1 0 0 0 0-11.8V4.3z"
                ></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
      <figcaption class="mt-2 text-sm text-muted">
        1622 서버 홍보 영상. 소리가 있으니 오른쪽 아래 버튼으로 켜고 끌 수 있습니다.
      </figcaption>
    </figure>

    <section aria-labelledby="player-feature-title" class="relative mt-6 overflow-hidden rounded-2xl border border-accent/30 bg-surface p-5 sm:p-8">
      <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-accent/5 blur-3xl"></div>
      <div class="relative grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-xs font-bold tracking-wider text-accent">닉네임으로 찾고, 지도에서 확인하세요</p>
          <h2 id="player-feature-title" class="mt-2 text-2xl font-extrabold sm:text-3xl">영주 장비 <span class="text-accent">&amp; 지도</span></h2>
          <div class="mt-4 border-l-2 border-accent pl-4">
            <p class="text-xs font-bold tracking-[0.16em] text-accent">KvK 필승 전략</p>
            <p class="mt-1 text-lg font-bold leading-snug text-text sm:text-xl">상대의 전투력부터 확인하세요.</p>
            <p class="mt-2 text-sm font-semibold tracking-widest text-accent-strong">지피지기 백전백승</p>
          </div>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">궁금한 영주의 전투력과 공개된 장비, 아레나 영웅을 한곳에서 확인하세요. 위치 지도에서 주변 도시와 연맹도 함께 살펴볼 수 있어요.</p>
        </div>
        <a href="/player/" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-xl bg-accent px-6 py-3 font-bold text-on-accent no-underline transition-colors hover:bg-accent-strong hover:text-on-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">영주 장비 &amp; 지도 바로가기 <span aria-hidden="true">→</span></a>
      </div>
      <ul class="relative mt-6 grid gap-3 sm:grid-cols-3">
        <li class="rounded-xl border border-border bg-bg/60 p-4"><span class="text-xl" aria-hidden="true">🔎</span><h3 class="mt-2 font-bold">ID를 몰라도 검색</h3><p class="mt-1 text-sm leading-relaxed text-muted">닉네임과 왕국 번호로 원하는 영주를 찾아보세요.</p></li>
        <li class="rounded-xl border border-border bg-bg/60 p-4"><span class="text-xl" aria-hidden="true">🛡️</span><h3 class="mt-2 font-bold">장비와 영웅을 한눈에</h3><p class="mt-1 text-sm leading-relaxed text-muted">공개된 영주 장비와 아레나 영웅의 장비·강화 상태를 확인하세요.</p></li>
        <li class="rounded-xl border border-border bg-bg/60 p-4"><span class="text-xl" aria-hidden="true">🗺️</span><h3 class="mt-2 font-bold">위치 지도가 바로 표시</h3><p class="mt-1 text-sm leading-relaxed text-muted">도시 위치와 주변 연맹을 보고, 다른 도시를 선택해 조회하세요.</p></li>
      </ul>
      <p class="relative mt-4 text-xs text-muted">장비는 공개된 정보만 표시하며, 위치 정보가 있는 영주는 지도가 자동으로 열립니다.</p>
    </section>

    <section aria-labelledby="unlock-feature-title" class="relative mt-6 overflow-hidden rounded-2xl border border-link/30 bg-surface p-5 sm:p-8">
      <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-link/10 blur-3xl"></div>
      <div class="relative grid items-center gap-8 md:grid-cols-[1fr_260px]">
        <div>
          <p class="text-xs font-bold tracking-wider text-link">다음 성장을 미리 준비하세요</p>
          <h2 id="unlock-feature-title" class="mt-2 text-2xl font-extrabold sm:text-3xl">우리 왕국의 <span class="text-link">콘텐츠 해금 예측</span></h2>
          <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">다음 영웅은 언제? 순금은 어디까지?<br />왕국 번호 하나로 앞으로 열릴 콘텐츠와 남은 날짜를 확인하세요.</p>
          <ul class="mt-5 flex flex-wrap gap-2 text-sm font-semibold">
            <li class="rounded-full border border-border bg-bg px-3 py-1.5">⚔️ 영웅 세대</li>
            <li class="rounded-full border border-border bg-bg px-3 py-1.5">✨ 순금 단계</li>
            <li class="rounded-full border border-border bg-bg px-3 py-1.5">🏰 전쟁 아카데미</li>
          </ul>
          <a href="/tools/content-unlock/" class="mt-6 inline-flex min-h-12 items-center justify-center gap-3 rounded-xl bg-link px-6 py-3 font-bold text-bg no-underline hover:bg-link-hover hover:text-bg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">우리 왕국 해금 일정 보기 <span aria-hidden="true">→</span></a>
          <p class="mt-3 text-xs text-muted">23개 콘텐츠의 예상 일정 · 게임 내 실제 해금과 다를 수 있습니다.</p>
        </div>
        <div aria-hidden="true" class="rounded-2xl border border-link/20 bg-bg p-5">
          <div class="flex items-center justify-between border-b border-border pb-4"><span class="text-sm font-bold text-link">성장 캘린더</span><span class="text-2xl">🗓️</span></div>
          <div class="mt-4 rounded-xl border border-accent/30 bg-accent/10 p-4"><p class="text-xs text-accent">NEXT UNLOCK</p><p class="mt-2 text-lg font-extrabold">다음 영웅 세대</p><p class="mt-1 text-sm text-muted">우리 왕국은 언제 열릴까?</p></div>
          <div class="mt-3 flex items-center gap-3 rounded-xl bg-surface p-3"><span class="text-xl">✨</span><div><p class="text-sm font-bold">순금 업그레이드</p><p class="text-xs text-muted">재료를 미리 준비하세요</p></div></div>
          <div class="mt-3 flex items-center gap-3 rounded-xl bg-surface p-3"><span class="text-xl">🏰</span><div><p class="text-sm font-bold">새로운 콘텐츠</p><p class="text-xs text-muted">앞으로의 일정을 한눈에</p></div></div>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        var root = document.querySelector('[data-intro]');
        if (!root) return;
        var video = root.querySelector('video');
        if (!video) return;

        var playBtn = root.querySelector('[data-intro-play]');
        var muteBtn = root.querySelector('[data-intro-mute]');

        var reduced = false;
        try {
          reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}

        function icon(btn, name, on) {
          if (!btn) return;
          var el = btn.querySelector('[data-icon="' + name + '"]');
          if (el) el.hidden = !on;
        }

        function syncPlay() {
          var playing = !video.paused && !video.ended;
          icon(playBtn, 'pause', playing);
          icon(playBtn, 'play', !playing);
          if (playBtn) playBtn.setAttribute('aria-label', playing ? '영상 일시정지' : '영상 재생');
        }

        function syncMute() {
          icon(muteBtn, 'muted', video.muted);
          icon(muteBtn, 'sound', !video.muted);
          if (muteBtn) muteBtn.setAttribute('aria-label', video.muted ? '소리 켜기' : '소리 끄기');
        }

        function tryPlay() {
          var p = video.play();
          if (p && typeof p.catch === 'function') p.catch(function () {});
        }

        // 모션 최소화 사용자: 자동재생하지 않고 포스터만 보여준다.
        if (reduced) {
          video.removeAttribute('autoplay');
          video.autoplay = false;
          try {
            video.pause();
          } catch (e) {}
        } else {
          tryPlay();
        }

        video.addEventListener('play', syncPlay);
        video.addEventListener('pause', syncPlay);
        video.addEventListener('volumechange', syncMute);

        if (playBtn) {
          playBtn.addEventListener('click', function () {
            if (video.paused) tryPlay();
            else video.pause();
          });
        }

        if (muteBtn) {
          muteBtn.addEventListener('click', function () {
            // 소리만 토글한다. 사용자가 멈춘 영상을 여기서 다시 재생시키지 않는다.
            video.muted = !video.muted;
          });
        }

        syncPlay();
        syncMute();
      })();
    </script>
  </section>

  {/* 2. 추천 공략 */}
  {
    featured.length > 0 && (
      <section aria-labelledby="featured" class="mx-auto max-w-6xl px-4 py-10">
        <div class="mb-5 flex items-end justify-between gap-4">
          <h2 id="featured" class="text-2xl font-extrabold">
            먼저 읽으면 좋은 글
          </h2>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((entry) => (
            <li>
              <GuideCard entry={entry} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 3. 최신 공략 */}
  {
    latest.length > 0 && (
      <section aria-labelledby="latest" class="mx-auto max-w-6xl px-4 py-10">
        <div class="mb-5 flex items-end justify-between gap-4">
          <h2 id="latest" class="text-2xl font-extrabold">
            새로 올라온 공략
          </h2>
          <a href="/guides/" class="text-sm font-bold text-link no-underline hover:underline">
            전체 보기 →
          </a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {latest.map((entry) => (
            <li>
              <GuideCard entry={entry} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 4. 카테고리 바로가기 */}
  <section aria-labelledby="categories" class="mx-auto max-w-6xl px-4 py-10">
    <h2 id="categories" class="mb-5 text-2xl font-extrabold">주제별로 찾기</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        CATEGORIES.map((category) => (
          <li>
            <a
              href={categoryHref(category)}
              class="flex h-full flex-col rounded-xl border border-border bg-surface p-4 no-underline transition-colors hover:border-accent/50 hover:bg-raised"
            >
              <span class="flex items-center gap-2 font-bold text-text">
                <span aria-hidden="true">{CATEGORY_EMOJI[category]}</span>
                {category}
                <span class="ml-auto text-xs font-normal text-muted">
                  {counts.get(category) ?? 0}편
                </span>
              </span>
              <span class="mt-1 line-clamp-2 text-sm text-muted">
                {CATEGORY_DESCRIPTIONS[category]}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 5. 데이터베이스 */}
  <section aria-labelledby="database" class="mx-auto max-w-6xl px-4 py-10">
    <h2 id="database" class="mb-5 text-2xl font-extrabold">데이터베이스</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        database.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex h-full flex-col rounded-xl border border-border bg-surface p-5 no-underline transition-colors hover:border-accent/50 hover:bg-raised"
            >
              <span class="text-3xl" aria-hidden="true">
                {item.emoji}
              </span>
              <span class="mt-3 text-lg font-extrabold text-text">{item.label}</span>
              <span class="mt-1 text-sm text-muted">{item.desc}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 6. 커뮤니티 */}
  <section aria-labelledby="community" class="mx-auto max-w-6xl px-4 py-10">
    <div
      class="flex flex-col gap-4 rounded-xl border border-border bg-surface p-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h2 id="community" class="text-xl font-extrabold sm:text-2xl">
          <span aria-hidden="true">💬</span> 같이 하실 분 찾습니다
        </h2>
        <p class="mt-2 text-sm font-semibold text-text">{KAKAO_OPENCHAT.roomName}</p>
        <p class="mt-1 text-sm text-muted">
          막히는 부분을 물어보고, 연맹원을 구하고, 새 정보를 먼저 받아보세요.
        </p>
      </div>
      <KakaoButton variant="full" size="md" text="오픈채팅 참여" class="shrink-0 self-start sm:self-auto" />
    </div>
  </section>

