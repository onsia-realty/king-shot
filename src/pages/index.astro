      <div tabindex="0" role="region" aria-label="영상 자리 4개, 좌우로 스크롤" data-aria-label-ko="영상 자리 4개, 좌우로 스크롤" data-aria-label-en="Four video slots; scroll horizontally" data-aria-label-zh-tw="四部影片，可水平捲動" class="grid grid-flow-col auto-cols-[76%] gap-4 overflow-x-auto overscroll-x-contain snap-x snap-mandatory rounded-2xl pb-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:auto-cols-[42%] lg:grid-flow-row lg:grid-cols-4 lg:auto-cols-auto lg:overflow-visible">
        {[1, 2, 3, 4].map((slot) => (
          <div data-short-slot={slot} class="relative aspect-[9/16] min-w-0 snap-start overflow-hidden rounded-2xl border border-border bg-surface">
            {slot === 1 ? (
              <video data-short-video class="h-full w-full object-contain" src="/video/amane-kvk.mp4" poster="/video/amane-kvk-poster.jpg" aria-label="아마네 KvK 영상" data-aria-label-ko="아마네 KvK 영상" data-aria-label-en="Amane KvK video" data-aria-label-zh-tw="Amane KvK 影片" controls muted loop playsinline preload="none"></video>
            ) : slot === 2 ? (
              <video data-short-video class="h-full w-full object-contain" src="/video/snow-bear-hunt.mp4" poster="/video/snow-bear-hunt-poster.jpg" aria-label="설원곰 사냥 영상" data-aria-label-ko="설원곰 사냥 영상" data-aria-label-en="Snow bear hunt video" data-aria-label-zh-tw="雪地獵熊影片" controls muted loop playsinline preload="none"></video>
            ) : slot === 3 ? (
              <video data-short-video class="h-full w-full object-contain" src="/video/gate-battle.mp4" poster="/video/gate-battle-poster.jpg" aria-label="성문 전투 영상" data-aria-label-ko="성문 전투 영상" data-aria-label-en="Gate battle video" data-aria-label-zh-tw="城門戰鬥影片" controls muted loop playsinline preload="none"></video>
            ) : (
              <video data-short-video class="h-full w-full object-contain" src="/video/jabel-elk-flight.mp4" poster="/video/jabel-elk-flight-poster.jpg" aria-label="제이벨 엘크 판타지 비행 영상" data-aria-label-ko="제이벨 엘크 판타지 비행 영상" data-aria-label-en="Jabel elk fantasy flight video" data-aria-label-zh-tw="Jabel 麋鹿奇幻飛行影片" controls muted loop playsinline preload="none"></video>
            )}
          </div>
        ))}
