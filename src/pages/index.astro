    </section>

    <script>
      const shorts = document.querySelectorAll<HTMLVideoElement>('[data-short-video]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !document.hidden && !reducedMotion.matches) {
            void video.play().catch(() => {});
          } else video.pause();
        }
      }, { threshold: 0.5 });
      shorts.forEach(video => observer.observe(video));
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) shorts.forEach(video => video.pause());
      });
    </script>

    <script is:inline>
      (function () {
        var root = document.querySelector('[data-intro]');
        if (!root) return;
        var video = root.querySelector('video');
        if (!video) return;

        var playBtn = root.querySelector('[data-intro-play]');
        var muteBtn = root.querySelector('[data-intro-mute]');

        var reduced = false;
        try {
          reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}

        function icon(btn, name, on) {
          if (!btn) return;
          var el = btn.querySelector('[data-icon="' + name + '"]');
          if (el) el.hidden = !on;
        }

        function controlLabel(btn, ko, en, zhTW) {
          if (!btn) return;
          btn.setAttribute('data-aria-label-ko', ko);
          btn.setAttribute('data-aria-label-en', en);
          btn.setAttribute('data-aria-label-zh-tw', zhTW);
          var lang = document.documentElement.lang;
          btn.setAttribute('aria-label', lang === 'zh-TW' ? zhTW : lang === 'en' ? en : ko);
        }

        function syncPlay() {
          var playing = !video.paused && !video.ended;
          icon(playBtn, 'pause', playing);
          icon(playBtn, 'play', !playing);
          controlLabel(playBtn, playing ? '영상 일시정지' : '영상 재생', playing ? 'Pause video' : 'Play video', playing ? '暫停影片' : '播放影片');
        }

        function syncMute() {
          icon(muteBtn, 'muted', video.muted);
          icon(muteBtn, 'sound', !video.muted);
          controlLabel(muteBtn, video.muted ? '소리 켜기' : '소리 끄기', video.muted ? 'Unmute video' : 'Mute video', video.muted ? '開啟聲音' : '靜音');
        }

        function tryPlay() {
          var p = video.play();
          if (p && typeof p.catch === 'function') p.catch(function () {});
        }

        // 모션 최소화 사용자: 자동재생하지 않고 포스터만 보여준다.
        if (reduced) {
          video.removeAttribute('autoplay');
          video.autoplay = false;
          try {
            video.pause();
          } catch (e) {}
        } else {
          tryPlay();
        }

        video.addEventListener('play', syncPlay);
        video.addEventListener('pause', syncPlay);
        video.addEventListener('volumechange', syncMute);

        if (playBtn) {
          playBtn.addEventListener('click', function () {
            if (video.paused) tryPlay();
            else video.pause();
          });
        }

        if (muteBtn) {
          muteBtn.addEventListener('click', function () {
            // 소리만 토글한다. 사용자가 멈춘 영상을 여기서 다시 재생시키지 않는다.
            video.muted = !video.muted;
          });
        }

        syncPlay();
        syncMute();
      })();
    </script>
  </section>

