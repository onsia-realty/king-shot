# Server-only MightPulse API key. Set locally in .env.local and in Vercel environment variables.
MIGHTPULSE_API_KEY=

# Server-only durable visitor counts. Configure on Vercel Production only.
# Preview and ordinary local dev return unknown (—), even with these credentials.
# VERCEL_ENV=production is supplied by Vercel; do not set it locally.
DATABASE_URL=
# Alternatively POSTGRES_URL; DATABASE_URL takes precedence. Never use PUBLIC_ variables.
# Apply migrations/001_visits.sql once before enabling the API (no request-time DDL).
# Optional manual localhost testing ONLY: separate development namespace rows.
VISITS_ALLOW_LOCAL=false
# Production uses production namespace rows. No counter rows expire.
